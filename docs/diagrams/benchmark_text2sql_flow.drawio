        <mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Phân tích dev set&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;notebook / script Python (json + collections.Counter)&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;dev.json&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;dev_gold.sql&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• Đếm số câu, đếm theo &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;difficulty&lt;/font&gt;, theo &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;db_id&lt;/font&gt;&lt;br&gt;• Đếm câu có / không có evidence&lt;br&gt;• Kiểm tra dev_gold.sql khớp thứ tự với dev.json&lt;br&gt;• Phân loại SQL đáp án 6 mức: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;app/scripts/sql_category.py: classify(sql)&lt;/font&gt;&lt;br&gt;• Quét evidence chứa hàm giả (DIVIDE, SUBTRACT, YEAR…): &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;evidence_norm.py&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Bảng thống kê (bên phải) → làm căn cứ thiết kế thí nghiệm" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="560" height="287" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="đọc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="&lt;b&gt;KẾT QUẢ PHÂN TÍCH&lt;/b&gt;&lt;hr&gt;&lt;b&gt;Tổng:&lt;/b&gt; 1.534 câu, 11 CSDL&lt;br&gt;&lt;b&gt;Độ khó:&lt;/b&gt; simple 925 · moderate 464 · challenging 145&lt;br&gt;&lt;b&gt;Theo db_id:&lt;/b&gt; card_games 191 · codebase_community 186 · formula_1 174 · thrombosis_prediction 163 · student_club 158 · toxicology 145 · superhero 129 · european_football_2 129 · financial 106 · california_schools 89 · debit_card_specializing 64&lt;br&gt;&lt;b&gt;Evidence:&lt;/b&gt; 1.386 câu có, 148 câu rỗng (với 148 câu này &quot;with&quot; và &quot;without&quot; cho prompt giống nhau)&lt;br&gt;&lt;b&gt;Hàm giả trong evidence:&lt;/b&gt; 192 evidence; 182 đổi được bằng &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;normalize_pseudo_sql&lt;/font&gt;; 21 sai cú pháp" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="680" y="520" width="520" height="238" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c12" target="c14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;classify(sql)&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;app/scripts/sql_category.py&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Gold SQL của 1 câu&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Tách token, gắn nhãn:&lt;br&gt;1 SINGLE_TABLE · 2 JOIN · 3 SET_OP · 4 OUTER_JOIN · 5 GROUP_BY · 6 DIVISION · (phụ) NESTED&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;{&#39;tags&#39;: [...], &#39;level&#39;: max mức, &#39;tables&#39;: [...], &#39;nested&#39;: bool}&lt;/font&gt;&lt;br&gt;→ dùng ở &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;ex_ves_by_category.py&lt;/font&gt; để chấm EX/VES theo từng mức" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1260" y="520" width="480" height="271" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c16">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="&lt;b&gt;DỮ LIỆU ĐI VÀO CÁC BƯỚC SAU&lt;/b&gt;&lt;hr&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;question&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;evidence&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;db_id&lt;/font&gt; (dev.json) → &lt;b&gt;② Sinh SQL&lt;/b&gt; (&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;decouple_question_schema&lt;/font&gt;)&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;dev_databases/&amp;lt;db_id&amp;gt;/&amp;lt;db_id&amp;gt;.sqlite&lt;/font&gt; → ② (đọc CREATE TABLE) và ③ (chạy SQL để chấm)&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;dev_gold.sql&lt;/font&gt; → &lt;b&gt;③ Chấm EX/VES&lt;/b&gt; (&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;package_sqls(mode=&#39;gt&#39;)&lt;/font&gt;)&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;difficulty&lt;/font&gt; (dev.json, tham số &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--diff_json_path&lt;/font&gt;) → ③ chia điểm simple/moderate/challenging&lt;br&gt;• 158 câu student_club (question_id 1312–1469) → nạp vào &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;app.sqlite / dev_question&lt;/font&gt; cho &lt;b&gt;⑤ ClubQuery&lt;/b&gt;" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="1700" height="155" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p2" name="2a. Benchmark - Sinh SQL">
    <mxGraphModel dx="2048" dy="947" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2000" pageHeight="4300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;whiteSpace=wrap;" value="② LUỒNG BENCHMARK — Sinh SQL cho 1.534 câu → predict_dev.json" vertex="1">
          <mxGeometry height="40" width="1900" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" value="Script: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;bird/llm/src/openai_request.py&lt;/font&gt; (GPT-3.5, bám sát &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;gpt_request.py&lt;/font&gt; gốc của paper) · &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;ollama_request.py&lt;/font&gt; / &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;ollama_request2.py&lt;/font&gt; (DeepSeek, Qwen, Gemma… chạy local qua Ollama trên Kaggle). Cột trái = chuỗi hàm; cột phải = ví dụ câu 1379." vertex="1">
          <mxGeometry height="30" width="1900" x="40" y="60" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 0. Chạy lệnh — main (argparse)&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;openai_request.py / ollama_request2.py&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;python src/openai_request.py --model gpt-3.5-turbo [--no_knowledge] [--cot] --eval_path ../data/dev.json --db_root_path ../data/dev_databases/ --data_output_path ./exp_result/openai_output/predict_dev.json [--limit N]&lt;/font&gt;&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--model&lt;/font&gt;: tên model API hoặc tag Ollama (&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;qwen2.5-coder:7b&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;deepseek-coder-v2:16b&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;gemma3:12b&lt;/font&gt;)&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--no_knowledge&lt;/font&gt;: chạy WITHOUT knowledge (bản ollama: dùng &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;ollama_request2.py&lt;/font&gt;)&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--normalize_evidence&lt;/font&gt; (bản *2): chuẩn hoá hàm giả trong evidence · &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--ids_file&lt;/font&gt;: chỉ chạy 1 số câu&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Đọc tham số; nạp &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;OPEN_AI_KEY&lt;/font&gt; từ .env, tạo &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;client = OpenAI(api_key)&lt;/font&gt; (bản Ollama: URL &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;http://localhost:11434/api/chat&lt;/font&gt;)&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;args&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;client&lt;/font&gt;" vertex="1">
          <mxGeometry height="304" width="760" x="40" y="110" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 1a. Đọc dev.json — json.load(open(eval_path))&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;main&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;args.eval_path&lt;/font&gt; = ../data/dev.json&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Đọc file JSON; nếu có &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--limit N&lt;/font&gt; → lấy N câu đầu&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;eval_data&lt;/font&gt;: list 1.534 dict {question_id, db_id, question, evidence, SQL, difficulty}" vertex="1">
          <mxGeometry height="221" width="760" x="40" y="464" as="geometry" />
        </mxCell>
        <mxCell id="c5" edge="1" parent="1" source="c3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" target="c4" value="eval_path">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c6" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 1b. Tách dữ liệu — decouple_question_schema(datasets, db_root_path)&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;openai_request.py / ollama_request.py&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;datasets&lt;/font&gt; = eval_data · &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;db_root_path&lt;/font&gt; = ../data/dev_databases/&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Duyệt từng phần tử, tách thành 3 list song song (cùng thứ tự với dev.json):&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;question_list.append(data[&#39;question&#39;])&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;db_path_list.append(os.path.join(db_root_path, db_id, db_id + &#39;.sqlite&#39;))&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;knowledge_list.append(data[&#39;evidence&#39;])&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;question_list, db_path_list, knowledge_list&lt;/font&gt; (mỗi list 1.534 phần tử; assert độ dài bằng nhau)" vertex="1">
          <mxGeometry height="271" width="760" x="40" y="735" as="geometry" />
        </mxCell>
        <mxCell id="c7" edge="1" parent="1" source="c4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" target="c6" value="eval_data">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c8" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" value="Bước 1c.&lt;br&gt;--no_knowledge ?" vertex="1">
          <mxGeometry height="100" width="300" x="270" y="1056" as="geometry" />
        </mxCell>
        <mxCell id="c9" edge="1" parent="1" source="c6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" target="c8" value="knowledge_list">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c10" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="&lt;b&gt;WITH knowledge&lt;/b&gt; (mặc định)&lt;br&gt;giữ &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;knowledge_list[i] = evidence&lt;/font&gt;&lt;br&gt;[bản *2 + &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--normalize_evidence&lt;/font&gt;]: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;knowledge = normalize_pseudo_sql(knowledge)&lt;/font&gt;&lt;br&gt;VD: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;YEAR(event_date)&lt;/font&gt; → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;CAST(STRFTIME(&#39;%Y&#39;, event_date) AS INTEGER)&lt;/font&gt;&lt;br&gt;→ output: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;exp_result/&amp;lt;model&amp;gt;_output/&lt;/font&gt;" vertex="1">
          <mxGeometry height="155" width="360" x="40" y="1196" as="geometry" />
        </mxCell>
        <mxCell id="c11" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="&lt;b&gt;WITHOUT knowledge&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;knowledge_list = [None] * len(question_list)&lt;/font&gt;&lt;br&gt;Prompt sẽ không có dòng External Knowledge, model phải tự đoán ánh xạ từ ngữ → cột/giá trị&lt;br&gt;→ output: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;exp_result/&amp;lt;model&amp;gt;_0_output/&lt;/font&gt;" vertex="1">
          <mxGeometry height="122" width="360" x="440" y="1196" as="geometry" />
        </mxCell>
        <mxCell id="c12" edge="1" parent="1" source="c8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="c10" value="Không có cờ">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c13" edge="1" parent="1" source="c8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="c11" value="Có cờ">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c14" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Vòng lặp: collect_response(client, model, db_path_list, question_list, knowledge_list, output_path, checkpoint_every=50, cot=False)&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;vòng lặp chính&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;3 list ở trên + client/model; &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;output_path&lt;/font&gt; để ghi checkpoint; &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;cot&lt;/font&gt; = dùng prompt Chain-of-Thought&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;for i, question in enumerate(tqdm(question_list)):&lt;/font&gt; → với mỗi câu gọi lần lượt bước 2 → 7 bên dưới; bọc trong &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;try/except&lt;/font&gt;: lỗi bất kỳ (mạng, hết retry) → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;sql = &quot;SELECT&quot;&lt;/font&gt; (câu đó chắc chắn bị chấm sai) và chạy tiếp&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;response_list&lt;/font&gt;: list 1.534 chuỗi" vertex="1">
          <mxGeometry height="254" width="720" x="60" y="1448" as="geometry" />
        </mxCell>
        <mxCell id="c15" edge="1" parent="1" source="c10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" target="c14" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c16" edge="1" parent="1" source="c11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" target="c14" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c17" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 2. Lấy cấu trúc bảng — generate_schema_prompt(db_path)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;db_path_list[i]&lt;/font&gt; — VD &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;../data/dev_databases/student_club/student_club.sqlite&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;sqlite3.connect(db_path)&lt;/font&gt; → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;SELECT name FROM sqlite_master WHERE type=&#39;table&#39;&lt;/font&gt; → với mỗi bảng (bỏ &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;sqlite_sequence&lt;/font&gt;): &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;SELECT sql FROM sqlite_master WHERE name=…&lt;/font&gt; lấy câu CREATE TABLE gốc → nối bằng &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;&#39;\n\n&#39;&lt;/font&gt;. Không kèm dòng dữ liệu mẫu (num_rows=None).&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;schema_prompt&lt;/font&gt;: chuỗi các câu CREATE TABLE (student_club: 8 bảng ≈ 2.300 ký tự)" vertex="1">
          <mxGeometry height="254" width="680" x="80" y="1742" as="geometry" />
        </mxCell>
        <mxCell id="c18" edge="1" parent="1" source="c14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" target="c17" value="db_path_list[i]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c19" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 3. Viết đề bài (+ evidence) — generate_comment_prompt(question, knowledge)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;question_list[i]&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;knowledge_list[i]&lt;/font&gt; (chuỗi evidence hoặc None)&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;knowledge rỗng/None&lt;/b&gt; → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;&quot;-- Using valid SQLite, answer the following questions for the tables provided above.\n-- &amp;lt;question&amp;gt;&quot;&lt;/font&gt;&lt;br&gt;&lt;b&gt;có knowledge&lt;/b&gt; → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;&quot;-- External Knowledge: &amp;lt;evidence&amp;gt;\n-- Using valid SQLite and understading External Knowledge, answer the following questions for the tables provided above.\n-- &amp;lt;question&amp;gt;&quot;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;comment_prompt&lt;/font&gt;" vertex="1">
          <mxGeometry height="271" width="680" x="80" y="2036" as="geometry" />
        </mxCell>
        <mxCell id="c20" edge="1" parent="1" source="c17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" target="c19" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c21" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 4. Ghép prompt — generate_combined_prompts_one(db_path, question, knowledge)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;schema_prompt&lt;/font&gt; (bước 2), &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;comment_prompt&lt;/font&gt; (bước 3)&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Ghép chuỗi, phần đuôi khác nhau theo script:&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;openai_request.py&lt;/font&gt;: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;schema + &#39;\n\n&#39; + comment + &#39;\nGenerate the SQL after thinking step by step: &#39; + &#39;\nSELECT &#39;&lt;/font&gt; (đúng như gpt_request.py gốc)&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;ollama_request.py&lt;/font&gt;: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;schema + &#39;\n\n&#39; + comment + &#39;\nRespond with the final SQLite query only, inside a ```sql code block. Do not add any explanation.&#39;&lt;/font&gt;&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--cot&lt;/font&gt;: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;generate_combined_prompts_cot&lt;/font&gt; = 1-shot ví dụ (few_shot / few_shot_no_kg) + schema + comment&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;prompt&lt;/font&gt; (string)" vertex="1">
          <mxGeometry height="320" width="680" x="80" y="2347" as="geometry" />
        </mxCell>
        <mxCell id="c22" edge="1" parent="1" source="c19" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" target="c21" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c23" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 5. Gọi LLM — call_openai(client, model, prompt, max_retries=5, max_tokens=256)  /  call_ollama(model, prompt, max_retries=3, timeout=120)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;prompt&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;model&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;OpenAI:&lt;/b&gt; &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;client.chat.completions.create(model, messages=[{&#39;role&#39;:&#39;user&#39;,&#39;content&#39;:prompt}], temperature=0, max_tokens=256, stop=[&#39;--&#39;,&#39;\n\n&#39;,&#39;;&#39;,&#39;#&#39;])&lt;/font&gt;; lỗi 429 (rate limit) → chờ rồi thử lại ≤ 5 lần&lt;br&gt;&lt;b&gt;Ollama:&lt;/b&gt; &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;requests.post(OLLAMA_URL, json={model, messages, stream: False, options:{temperature:0}}, timeout=120)&lt;/font&gt;; lỗi → chờ 3s, thử lại ≤ 3 lần&lt;br&gt;temperature=0 → luôn chọn token xác suất cao nhất → kết quả lặp lại được&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;raw&lt;/font&gt;: chuỗi model trả về (có thể kèm ```sql …```, &amp;lt;think&amp;gt;…&amp;lt;/think&amp;gt;, giải thích)" vertex="1">
          <mxGeometry height="304" width="680" x="80" y="2707" as="geometry" />
        </mxCell>
        <mxCell id="c24" edge="1" parent="1" source="c21" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" target="c23" value="prompt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c25" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 6. Tách SQL — extract_sql(raw)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;raw&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;Ollama:&lt;/b&gt; xoá &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;&amp;lt;think&amp;gt;…&amp;lt;/think&amp;gt;&lt;/font&gt; → lấy nội dung khối &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;```sql … ```&lt;/font&gt; (không có thì bỏ fence mở) → cắt tại dấu &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;;&lt;/font&gt; đầu tiên → strip&lt;br&gt;&lt;b&gt;OpenAI:&lt;/b&gt; như trên, rồi bỏ &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;SELECT&lt;/font&gt; ở đầu (nếu có) và thêm lại &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;&#39;SELECT &#39;&lt;/font&gt; — mô phỏng code gốc &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;&#39;SELECT&#39; + completion_text&lt;/font&gt;&lt;br&gt;&lt;b&gt;--cot:&lt;/b&gt; &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;extract_sql_cot&lt;/font&gt; tách theo mốc &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;&#39;: SELECT&#39;&lt;/font&gt;&lt;br&gt;Rỗng → trả &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;&quot;SELECT&quot;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;sql&lt;/font&gt; — 1 câu SQL sạch, không dấu ;" vertex="1">
          <mxGeometry height="304" width="680" x="80" y="3051" as="geometry" />
        </mxCell>
        <mxCell id="c26" edge="1" parent="1" source="c23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" target="c25" value="raw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c27" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 7. Gắn tên CSDL + checkpoint&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;sql&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;db_id = basename(db_path).replace(&quot;.sqlite&quot;,&quot;&quot;)&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;response_list.append(sql + &#39;\t----- bird -----\t&#39; + db_id)&lt;/font&gt; — chuỗi phân cách này để &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;package_sqls&lt;/font&gt; ở bước chấm tách lại (sql, db_name)&lt;br&gt;Cứ &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;(i+1) % 50 == 0&lt;/font&gt; → ghi tạm &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;generate_sql_file&lt;/font&gt; (phòng mất phiên Kaggle)&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;1 phần tử của &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;response_list&lt;/font&gt; → quay lại vòng lặp với câu i+1" vertex="1">
          <mxGeometry height="254" width="680" x="80" y="3395" as="geometry" />
        </mxCell>
        <mxCell id="c28" edge="1" parent="1" source="c25" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" target="c27" value="sql">
