<mxfile host="app.diagrams.net" agent="claude" version="24.0.0"><diagram id="p0" name="0. Tổng quan"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="TỔNG QUAN: Benchmark BIRD (Text-to-SQL) và ứng dụng ClubQuery" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="40" as="geometry"/></mxCell><mxCell id="c2" value="Màu: &lt;b&gt;xanh dương&lt;/b&gt; = hàm sinh SQL · &lt;b&gt;tím&lt;/b&gt; = hàm chấm điểm · &lt;b&gt;cam&lt;/b&gt; = gọi LLM · &lt;b&gt;đỏ&lt;/b&gt; = kiểm tra an toàn · &lt;b&gt;xanh lá&lt;/b&gt; = ứng dụng web · &lt;b&gt;vàng&lt;/b&gt; = dữ liệu/file. Chi tiết từng hàm (input → xử lý → output) xem các trang 1 → 3." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1800" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;div style="font-size:15px"&gt;&lt;b&gt;① CHUẨN BỊ DỮ LIỆU&lt;/b&gt;&lt;/div&gt;&lt;i&gt;(trang 1)&lt;/i&gt;&lt;hr&gt;• Tải BIRD dev → &lt;font face="Consolas" color="#1f4e79"&gt;bird/data/&lt;/font&gt;&lt;br&gt;• &lt;font face="Consolas" color="#1f4e79"&gt;dev.json&lt;/font&gt;: 1.534 câu {question_id, db_id, question, evidence, SQL, difficulty}&lt;br&gt;• &lt;font face="Consolas" color="#1f4e79"&gt;dev_gold.sql&lt;/font&gt;: 1.534 dòng &lt;font face="Consolas" color="#1f4e79"&gt;SQL\tdb_id&lt;/font&gt;&lt;br&gt;• &lt;font face="Consolas" color="#1f4e79"&gt;dev_databases/&lt;/font&gt;: 11 CSDL SQLite&lt;br&gt;• Phân tích: độ khó 925/464/145; 11 db_id; 1.386 câu có evidence, 148 câu rỗng; phân loại SQL 6 mức; 192 evidence có hàm giả' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="330" height="221" as="geometry"/></mxCell><mxCell id="c4" value="Cấu hình&lt;br&gt;evidence?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="200" width="200" height="120" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;WITH knowledge&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;knowledge_list[i] = evidence&lt;/font&gt;&lt;br&gt;Prompt có dòng &lt;font face="Consolas" color="#1f4e79"&gt;-- External Knowledge: …&lt;/font&gt;&lt;br&gt;→ thư mục &lt;font face="Consolas" color="#1f4e79"&gt;*_output/&lt;/font&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="690" y="130" width="270" height="122" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;WITHOUT knowledge&lt;/b&gt;&lt;br&gt;cờ &lt;font face="Consolas" color="#1f4e79"&gt;--no_knowledge&lt;/font&gt; → &lt;font face="Consolas" color="#1f4e79"&gt;knowledge_list = [None]*n&lt;/font&gt;&lt;br&gt;Prompt không có evidence&lt;br&gt;→ thư mục &lt;font face="Consolas" color="#1f4e79"&gt;*_0_output/&lt;/font&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="690" y="300" width="270" height="122" as="geometry"/></mxCell><mxCell id="c7" value='&lt;div style="font-size:15px"&gt;&lt;b&gt;② SINH SQL (benchmark)&lt;/b&gt;&lt;/div&gt;&lt;i&gt;(trang 2a)&lt;/i&gt; &lt;font face="Consolas" color="#1f4e79"&gt;openai_request.py&lt;/font&gt; / &lt;font face="Consolas" color="#1f4e79"&gt;ollama_request(2).py&lt;/font&gt;&lt;hr&gt;Lặp từng câu i = 0 … 1533:&lt;br&gt;1. &lt;font face="Consolas" color="#1f4e79"&gt;decouple_question_schema&lt;/font&gt; → question, db_path, knowledge&lt;br&gt;2. &lt;font face="Consolas" color="#1f4e79"&gt;generate_schema_prompt&lt;/font&gt; → CREATE TABLE…&lt;br&gt;3. &lt;font face="Consolas" color="#1f4e79"&gt;generate_comment_prompt&lt;/font&gt; → evidence + câu hỏi&lt;br&gt;4. &lt;font face="Consolas" color="#1f4e79"&gt;generate_combined_prompts_one&lt;/font&gt; → prompt&lt;br&gt;5. &lt;font face="Consolas" color="#1f4e79"&gt;call_openai / call_ollama&lt;/font&gt; → raw text&lt;br&gt;6. &lt;font face="Consolas" color="#1f4e79"&gt;extract_sql&lt;/font&gt; → SQL&lt;br&gt;7. ghép &lt;font face="Consolas" color="#1f4e79"&gt;SQL + "\t----- bird -----\t" + db_id&lt;/font&gt;&lt;br&gt;8. &lt;font face="Consolas" color="#1f4e79"&gt;generate_sql_file&lt;/font&gt; → predict_dev.json' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1020" y="130" width="360" height="254" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;predict_dev.json&lt;/b&gt;&lt;br&gt;{"0": "SELECT …\t----- bird -----\tcalifornia_schools", …, "1533": …}&lt;br&gt;(đủ 1.534 khoá)' style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;size=0.08;" vertex="1" parent="1"><mxGeometry x="1440" y="190" width="230" height="120" as="geometry"/></mxCell><mxCell id="c9" value='&lt;div style="font-size:15px"&gt;&lt;b&gt;③ CHẤM EX&lt;/b&gt;&lt;/div&gt;&lt;i&gt;(trang 2b)&lt;/i&gt; &lt;font face="Consolas" color="#1f4e79"&gt;evaluation.py&lt;/font&gt;&lt;hr&gt;Chạy predicted SQL và gold SQL trên cùng CSDL;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;set(pred_rows) == set(gold_rows)&lt;/font&gt; → 1/0&lt;br&gt;EX = 100 × Σ đúng / N (theo simple / moderate / challenging / total)' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1730" y="110" width="330" height="155" as="geometry"/></mxCell><mxCell id="c10" value='&lt;div style="font-size:15px"&gt;&lt;b&gt;③ CHẤM VES&lt;/b&gt;&lt;/div&gt;&lt;i&gt;(trang 2c)&lt;/i&gt; &lt;font face="Consolas" color="#1f4e79"&gt;evaluation_ves.py&lt;/font&gt;&lt;hr&gt;Câu đúng → chạy lại &lt;font face="Consolas" color="#1f4e79"&gt;iterate_num&lt;/font&gt; lần, R = t_gold / t_pred;&lt;br&gt;VES = 100 × Σ √R / N (câu sai R = 0)' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1730" y="300" width="330" height="139" as="geometry"/></mxCell><mxCell id="c11" value='&lt;div style="font-size:15px"&gt;&lt;b&gt;④ BẢNG KẾT QUẢ&lt;/b&gt;&lt;/div&gt;&lt;i&gt;(trang 2d)&lt;/i&gt;&lt;hr&gt;Lặp cho mỗi model ∈ {GPT-3.5-Turbo (paper), DeepSeek-Coder-V2, Qwen2.5-Coder, Gemma3, …} × {with, without}:&lt;br&gt;→ 2 file predict_dev.json → 4 con số: &lt;b&gt;EX w/ KG · EX w/o KG · VES w/ KG · VES w/o KG&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1440" y="520" width="620" height="139" as="geometry"/></mxCell><mxCell id="c12" value="question, evidence,&lt;br&gt;db_id, db_path" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="có evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="1.534 SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="EX" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2100" y="190"/><mxPoint x="2100" y="560"/></Array></mxGeometry></mxCell><mxCell id="c21" value="VES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="dev_gold.sql + difficulty (dev.json)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;fontColor=#555555;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="205" y="100"/><mxPoint x="1895" y="100"/></Array></mxGeometry></mxCell><mxCell id="c23" value='&lt;div style="font-size:15px"&gt;&lt;b&gt;⑤ LUỒNG TEXT-TO-SQL (ứng dụng ClubQuery) — trang 3&lt;/b&gt;&lt;/div&gt;Cùng lõi "dựng prompt → gọi LLM → extract_sql" với benchmark; khác ở chỗ: không ghi predict_dev.json mà &lt;b&gt;kiểm tra an toàn → chạy SQL chỉ đọc → sinh câu trả lời tiếng Việt → so với gold (nếu là câu dev) → ghi log → hiển thị UI&lt;/b&gt;.' style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=none;dashed=1;strokeColor=#888888;fontSize=13;fontStyle=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="2020" height="640" as="geometry"/></mxCell><mxCell id="c24" value='&lt;b&gt;UI (app.js)&lt;/b&gt;&lt;br&gt;Người dùng gõ câu hỏi / chọn câu dev, model, tick evidence, từ điển → &lt;font face="Consolas" color="#1f4e79"&gt;POST /api/ask&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="820" width="220" height="150" as="geometry"/></mxCell><mxCell id="c25" value='&lt;b&gt;main.ask&lt;/b&gt; + &lt;font face="Consolas" color="#1f4e79"&gt;current_user&lt;/font&gt;&lt;br&gt;xác thực token, lấy role → &lt;font face="Consolas" color="#1f4e79"&gt;service.ask&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="820" width="220" height="150" as="geometry"/></mxCell><mxCell id="c26" value='&lt;b&gt;Ghép knowledge&lt;/b&gt;&lt;br&gt;evidence câu dev / evidence tự nhập + &lt;font face="Consolas" color="#1f4e79"&gt;match_glossary&lt;/font&gt; → &lt;font face="Consolas" color="#1f4e79"&gt;normalize_pseudo_sql&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="820" width="220" height="150" as="geometry"/></mxCell><mxCell id="c27" value='&lt;b&gt;prompt.build_prompt&lt;/b&gt;&lt;br&gt;schema đã lọc theo role + comment + "Respond … ```sql"' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="850" y="820" width="220" height="150" as="geometry"/></mxCell><mxCell id="c28" value='&lt;b&gt;llm.generate_sql&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;complete()&lt;/font&gt; (OpenAI-compatible: OpenAI/Groq/Ollama) → &lt;font face="Consolas" color="#1f4e79"&gt;extract_sql&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1110" y="820" width="220" height="150" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;guard.check_select&lt;/b&gt;&lt;br&gt;1 câu, chỉ SELECT/WITH&lt;br&gt;&lt;b&gt;guard.execute&lt;/b&gt;&lt;br&gt;read-only + authorizer + timeout 10s" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1370" y="820" width="220" height="150" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;answer.make_answer&lt;/b&gt;&lt;br&gt;LLM trả lời 1–3 câu tiếng Việt (hoặc template)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1630" y="820" width="220" height="150" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c28" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c29" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value='&lt;b&gt;So với gold&lt;/b&gt; (nếu là câu dev)&lt;br&gt;chạy gold SQL quyền admin → &lt;font face="Consolas" color="#1f4e79"&gt;same_result = set(rows)==set(gold_rows)&lt;/font&gt; → is_correct' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1630" y="1030" width="220" height="130" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Ghi query_log&lt;/b&gt;&lt;br&gt;câu hỏi, SQL, trạng thái, latency, is_correct…" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1370" y="1030" width="220" height="130" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;UI renderResult()&lt;/b&gt;&lt;br&gt;SQL · bảng kết quả · câu trả lời · evidence đã dùng · gold SQL + Đúng/Sai · trạng thái" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1110" y="1030" width="220" height="130" as="geometry"/></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c30" target="c37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c37" target="c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c38" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c43" value="dùng chung cấu trúc prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;fontColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1200" y="790"/><mxPoint x="960" y="790"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="1. Chuẩn bị dữ liệu"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="① CHUẨN BỊ DỮ LIỆU — tải và phân tích tập BIRD dev" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="40" as="geometry"/></mxCell><mxCell id="c2" value="Mục tiêu: có đủ câu hỏi + evidence + CSDL để sinh SQL, và đáp án gold + độ khó để chấm. Không sửa dev.json / CSDL (giữ nguyên để so sánh công bằng với paper)." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1700" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;div style="font-size:14px"&gt;&lt;b&gt;Tải BIRD dev set&lt;/b&gt;&lt;/div&gt;&lt;font color="#666666"&gt;&lt;i&gt;bird-bench.github.io → dev.zip (bản dev_20240627)&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#1a7f37"&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Link tải bộ dev của BIRD&lt;hr&gt;&lt;b&gt;&lt;font color="#9a6700"&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Giải nén vào &lt;font face="Consolas" color="#1f4e79"&gt;src/DAMO-ConvAI/bird/data/&lt;/font&gt;; giải nén tiếp &lt;font face="Consolas" color="#1f4e79"&gt;dev_databases.zip&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#cf222e"&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Thư mục &lt;font face="Consolas" color="#1f4e79"&gt;bird/data/&lt;/font&gt; gồm 4 thành phần (bên phải)' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="400" height="238" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;dev.json&lt;/b&gt; — 1.534 phần tử&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;{&lt;br&gt;&amp;nbsp;&quot;question_id&quot;: 1379,&lt;br&gt;&amp;nbsp;&quot;db_id&quot;: &quot;student_club&quot;,&lt;br&gt;&amp;nbsp;&quot;question&quot;: &quot;How many meeting events were held in 2020?&quot;,&lt;br&gt;&amp;nbsp;&quot;evidence&quot;: &quot;meeting events refers to type = 'Meeting'; held in 2020 refers to YEAR(event_date) = 2020&quot;,&lt;br&gt;&amp;nbsp;&quot;SQL&quot;: &quot;SELECT COUNT(event_id) FROM event WHERE …&quot;,&lt;br&gt;&amp;nbsp;&quot;difficulty&quot;: &quot;simple&quot;&lt;br&gt;}&lt;/font&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;size=0.08;" vertex="1" parent="1"><mxGeometry x="520" y="110" width="380" height="221" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;dev_gold.sql&lt;/b&gt; — 1.534 dòng&lt;br&gt;Mỗi dòng: &lt;font face="Consolas" color="#1f4e79"&gt;&amp;lt;gold SQL&amp;gt;\t&amp;lt;db_id&amp;gt;&lt;/font&gt;&lt;br&gt;Dòng i ↔ dev.json[i] ↔ khoá "i" trong predict_dev.json&lt;br&gt;(nằm ở &lt;font face="Consolas" color="#1f4e79"&gt;bird/llm/data/dev_gold.sql&lt;/font&gt;)' style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;size=0.08;" vertex="1" parent="1"><mxGeometry x="960" y="110" width="360" height="122" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;dev_databases/&lt;/b&gt; — 11 CSDL SQLite&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;&amp;lt;db_root&amp;gt;/&amp;lt;db_id&amp;gt;/&amp;lt;db_id&amp;gt;.sqlite&lt;/font&gt;&lt;br&gt;+ &lt;font face="Consolas" color="#1f4e79"&gt;database_description/*.csv&lt;/font&gt; (mô tả cột – prompt KHÔNG dùng)' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;align=center;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="290" width="360" height="120" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;dev_tables.json&lt;/b&gt;&lt;br&gt;schema dạng JSON (tên bảng, cột, khoá) – tham khảo, luồng benchmark lấy schema trực tiếp từ sqlite_master" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;size=0.08;" vertex="1" parent="1"><mxGeometry x="1380" y="110" width="300" height="120" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value='&lt;div style="font-size:14px"&gt;&lt;b&gt;Phân tích dev set&lt;/b&gt;&lt;/div&gt;&lt;font color="#666666"&gt;&lt;i&gt;notebook / script Python (json + collections.Counter)&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#1a7f37"&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;dev.json&lt;/font&gt;, &lt;font face="Consolas" color="#1f4e79"&gt;dev_gold.sql&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#9a6700"&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• Đếm số câu, đếm theo &lt;font face="Consolas" color="#1f4e79"&gt;difficulty&lt;/font&gt;, theo &lt;font face="Consolas" color="#1f4e79"&gt;db_id&lt;/font&gt;&lt;br&gt;• Đếm câu có / không có evidence&lt;br&gt;• Kiểm tra dev_gold.sql khớp thứ tự với dev.json&lt;br&gt;• Phân loại SQL đáp án 6 mức: &lt;font face="Consolas" color="#1f4e79"&gt;app/scripts/sql_category.py: classify(sql)&lt;/font&gt;&lt;br&gt;• Quét evidence chứa hàm giả (DIVIDE, SUBTRACT, YEAR…): &lt;font face="Consolas" color="#1f4e79"&gt;evidence_norm.py&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#cf222e"&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Bảng thống kê (bên phải) → làm căn cứ thiết kế thí nghiệm' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="560" height="287" as="geometry"/></mxCell><mxCell id="c13" value="đọc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value='&lt;b&gt;KẾT QUẢ PHÂN TÍCH&lt;/b&gt;&lt;hr&gt;&lt;b&gt;Tổng:&lt;/b&gt; 1.534 câu, 11 CSDL&lt;br&gt;&lt;b&gt;Độ khó:&lt;/b&gt; simple 925 · moderate 464 · challenging 145&lt;br&gt;&lt;b&gt;Theo db_id:&lt;/b&gt; card_games 191 · codebase_community 186 · formula_1 174 · thrombosis_prediction 163 · student_club 158 · toxicology 145 · superhero 129 · european_football_2 129 · financial 106 · california_schools 89 · debit_card_specializing 64&lt;br&gt;&lt;b&gt;Evidence:&lt;/b&gt; 1.386 câu có, 148 câu rỗng (với 148 câu này "with" và "without" cho prompt giống nhau)&lt;br&gt;&lt;b&gt;Hàm giả trong evidence:&lt;/b&gt; 192 evidence; 182 đổi được bằng &lt;font face="Consolas" color="#1f4e79"&gt;normalize_pseudo_sql&lt;/font&gt;; 21 sai cú pháp' style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="520" width="520" height="238" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;classify(sql)&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;app/scripts/sql_category.py&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Gold SQL của 1 câu&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Tách token, gắn nhãn:&lt;br&gt;1 SINGLE_TABLE · 2 JOIN · 3 SET_OP · 4 OUTER_JOIN · 5 GROUP_BY · 6 DIVISION · (phụ) NESTED&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;{'tags': [...], 'level': max mức, 'tables': [...], 'nested': bool}&lt;/font&gt;&lt;br&gt;→ dùng ở &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;ex_ves_by_category.py&lt;/font&gt; để chấm EX/VES theo từng mức" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="520" width="480" height="271" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="&lt;b&gt;DỮ LIỆU ĐI VÀO CÁC BƯỚC SAU&lt;/b&gt;&lt;hr&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;question&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;evidence&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;db_id&lt;/font&gt; (dev.json) → &lt;b&gt;② Sinh SQL&lt;/b&gt; (&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;decouple_question_schema&lt;/font&gt;)&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;dev_databases/&amp;lt;db_id&amp;gt;/&amp;lt;db_id&amp;gt;.sqlite&lt;/font&gt; → ② (đọc CREATE TABLE) và ③ (chạy SQL để chấm)&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;dev_gold.sql&lt;/font&gt; → &lt;b&gt;③ Chấm EX/VES&lt;/b&gt; (&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;package_sqls(mode='gt')&lt;/font&gt;)&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;difficulty&lt;/font&gt; (dev.json, tham số &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--diff_json_path&lt;/font&gt;) → ③ chia điểm simple/moderate/challenging&lt;br&gt;• 158 câu student_club (question_id 1312–1469) → nạp vào &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;app.sqlite / dev_question&lt;/font&gt; cho &lt;b&gt;⑤ ClubQuery&lt;/b&gt;" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="1700" height="155" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2a. Benchmark - Sinh SQL"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="4300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="② LUỒNG BENCHMARK — Sinh SQL cho 1.534 câu → predict_dev.json" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1900" height="40" as="geometry"/></mxCell><mxCell id="c2" value='Script: &lt;font face="Consolas" color="#1f4e79"&gt;bird/llm/src/openai_request.py&lt;/font&gt; (GPT-3.5, bám sát &lt;font face="Consolas" color="#1f4e79"&gt;gpt_request.py&lt;/font&gt; gốc của paper) · &lt;font face="Consolas" color="#1f4e79"&gt;ollama_request.py&lt;/font&gt; / &lt;font face="Consolas" color="#1f4e79"&gt;ollama_request2.py&lt;/font&gt; (DeepSeek, Qwen, Gemma… chạy local qua Ollama trên Kaggle). Cột trái = chuỗi hàm; cột phải = ví dụ câu 1379.' style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;div style="font-size:14px"&gt;&lt;b&gt;Bước 0. Chạy lệnh — main (argparse)&lt;/b&gt;&lt;/div&gt;&lt;font color="#666666"&gt;&lt;i&gt;openai_request.py / ollama_request2.py&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#1a7f37"&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;python src/openai_request.py --model gpt-3.5-turbo [--no_knowledge] [--cot] --eval_path ../data/dev.json --db_root_path ../data/dev_databases/ --data_output_path ./exp_result/openai_output/predict_dev.json [--limit N]&lt;/font&gt;&lt;br&gt;• &lt;font face="Consolas" color="#1f4e79"&gt;--model&lt;/font&gt;: tên model API hoặc tag Ollama (&lt;font face="Consolas" color="#1f4e79"&gt;qwen2.5-coder:7b&lt;/font&gt;, &lt;font face="Consolas" color="#1f4e79"&gt;deepseek-coder-v2:16b&lt;/font&gt;, &lt;font face="Consolas" color="#1f4e79"&gt;gemma3:12b&lt;/font&gt;)&lt;br&gt;• &lt;font face="Consolas" color="#1f4e79"&gt;--no_knowledge&lt;/font&gt;: chạy WITHOUT knowledge (bản ollama: dùng &lt;font face="Consolas" color="#1f4e79"&gt;ollama_request2.py&lt;/font&gt;)&lt;br&gt;• &lt;font face="Consolas" color="#1f4e79"&gt;--normalize_evidence&lt;/font&gt; (bản *2): chuẩn hoá hàm giả trong evidence · &lt;font face="Consolas" color="#1f4e79"&gt;--ids_file&lt;/font&gt;: chỉ chạy 1 số câu&lt;hr&gt;&lt;b&gt;&lt;font color="#9a6700"&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Đọc tham số; nạp &lt;font face="Consolas" color="#1f4e79"&gt;OPEN_AI_KEY&lt;/font&gt; từ .env, tạo &lt;font face="Consolas" color="#1f4e79"&gt;client = OpenAI(api_key)&lt;/font&gt; (bản Ollama: URL &lt;font face="Consolas" color="#1f4e79"&gt;http://localhost:11434/api/chat&lt;/font&gt;)&lt;hr&gt;&lt;b&gt;&lt;font color="#cf222e"&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;args&lt;/font&gt;, &lt;font face="Consolas" color="#1f4e79"&gt;client&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="760" height="304" as="geometry"/></mxCell><mxCell id="c4" value='&lt;div style="font-size:14px"&gt;&lt;b&gt;Bước 1a. Đọc dev.json — json.load(open(eval_path))&lt;/b&gt;&lt;/div&gt;&lt;font color="#666666"&gt;&lt;i&gt;main&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#1a7f37"&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;args.eval_path&lt;/font&gt; = ../data/dev.json&lt;hr&gt;&lt;b&gt;&lt;font color="#9a6700"&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Đọc file JSON; nếu có &lt;font face="Consolas" color="#1f4e79"&gt;--limit N&lt;/font&gt; → lấy N câu đầu&lt;hr&gt;&lt;b&gt;&lt;font color="#cf222e"&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;eval_data&lt;/font&gt;: list 1.534 dict {question_id, db_id, question, evidence, SQL, difficulty}' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="464" width="760" height="221" as="geometry"/></mxCell><mxCell id="c5" value="eval_path" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 1b. Tách dữ liệu — decouple_question_schema(datasets, db_root_path)&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;openai_request.py / ollama_request.py&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;datasets&lt;/font&gt; = eval_data · &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;db_root_path&lt;/font&gt; = ../data/dev_databases/&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Duyệt từng phần tử, tách thành 3 list song song (cùng thứ tự với dev.json):&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;question_list.append(data['question'])&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;db_path_list.append(os.path.join(db_root_path, db_id, db_id + '.sqlite'))&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;knowledge_list.append(data['evidence'])&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;question_list, db_path_list, knowledge_list&lt;/font&gt; (mỗi list 1.534 phần tử; assert độ dài bằng nhau)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="735" width="760" height="271" as="geometry"/></mxCell><mxCell id="c7" value="eval_data" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="Bước 1c.&lt;br&gt;--no_knowledge ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270" y="1056" width="300" height="100" as="geometry"/></mxCell><mxCell id="c9" value="knowledge_list" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="&lt;b&gt;WITH knowledge&lt;/b&gt; (mặc định)&lt;br&gt;giữ &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;knowledge_list[i] = evidence&lt;/font&gt;&lt;br&gt;[bản *2 + &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--normalize_evidence&lt;/font&gt;]: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;knowledge = normalize_pseudo_sql(knowledge)&lt;/font&gt;&lt;br&gt;VD: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;YEAR(event_date)&lt;/font&gt; → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;CAST(STRFTIME('%Y', event_date) AS INTEGER)&lt;/font&gt;&lt;br&gt;→ output: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;exp_result/&amp;lt;model&amp;gt;_output/&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1196" width="360" height="155" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;WITHOUT knowledge&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;knowledge_list = [None] * len(question_list)&lt;/font&gt;&lt;br&gt;Prompt sẽ không có dòng External Knowledge, model phải tự đoán ánh xạ từ ngữ → cột/giá trị&lt;br&gt;→ output: &lt;font face="Consolas" color="#1f4e79"&gt;exp_result/&amp;lt;model&amp;gt;_0_output/&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1196" width="360" height="122" as="geometry"/></mxCell><mxCell id="c12" value="Không có cờ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="Có cờ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value='&lt;div style="font-size:14px"&gt;&lt;b&gt;Vòng lặp: collect_response(client, model, db_path_list, question_list, knowledge_list, output_path, checkpoint_every=50, cot=False)&lt;/b&gt;&lt;/div&gt;&lt;font color="#666666"&gt;&lt;i&gt;vòng lặp chính&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#1a7f37"&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;3 list ở trên + client/model; &lt;font face="Consolas" color="#1f4e79"&gt;output_path&lt;/font&gt; để ghi checkpoint; &lt;font face="Consolas" color="#1f4e79"&gt;cot&lt;/font&gt; = dùng prompt Chain-of-Thought&lt;hr&gt;&lt;b&gt;&lt;font color="#9a6700"&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;for i, question in enumerate(tqdm(question_list)):&lt;/font&gt; → với mỗi câu gọi lần lượt bước 2 → 7 bên dưới; bọc trong &lt;font face="Consolas" color="#1f4e79"&gt;try/except&lt;/font&gt;: lỗi bất kỳ (mạng, hết retry) → &lt;font face="Consolas" color="#1f4e79"&gt;sql = "SELECT"&lt;/font&gt; (câu đó chắc chắn bị chấm sai) và chạy tiếp&lt;hr&gt;&lt;b&gt;&lt;font color="#cf222e"&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;response_list&lt;/font&gt;: list 1.534 chuỗi' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="1448" width="720" height="254" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 2. Lấy cấu trúc bảng — generate_schema_prompt(db_path)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;db_path_list[i]&lt;/font&gt; — VD &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;../data/dev_databases/student_club/student_club.sqlite&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;sqlite3.connect(db_path)&lt;/font&gt; → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;SELECT name FROM sqlite_master WHERE type='table'&lt;/font&gt; → với mỗi bảng (bỏ &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;sqlite_sequence&lt;/font&gt;): &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;SELECT sql FROM sqlite_master WHERE name=…&lt;/font&gt; lấy câu CREATE TABLE gốc → nối bằng &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;'\n\n'&lt;/font&gt;. Không kèm dòng dữ liệu mẫu (num_rows=None).&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;schema_prompt&lt;/font&gt;: chuỗi các câu CREATE TABLE (student_club: 8 bảng ≈ 2.300 ký tự)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="1742" width="680" height="254" as="geometry"/></mxCell><mxCell id="c18" value="db_path_list[i]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value='&lt;div style="font-size:14px"&gt;&lt;b&gt;Bước 3. Viết đề bài (+ evidence) — generate_comment_prompt(question, knowledge)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#1a7f37"&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;question_list[i]&lt;/font&gt;, &lt;font face="Consolas" color="#1f4e79"&gt;knowledge_list[i]&lt;/font&gt; (chuỗi evidence hoặc None)&lt;hr&gt;&lt;b&gt;&lt;font color="#9a6700"&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;knowledge rỗng/None&lt;/b&gt; → &lt;font face="Consolas" color="#1f4e79"&gt;"-- Using valid SQLite, answer the following questions for the tables provided above.\n-- &amp;lt;question&amp;gt;"&lt;/font&gt;&lt;br&gt;&lt;b&gt;có knowledge&lt;/b&gt; → &lt;font face="Consolas" color="#1f4e79"&gt;"-- External Knowledge: &amp;lt;evidence&amp;gt;\n-- Using valid SQLite and understading External Knowledge, answer the following questions for the tables provided above.\n-- &amp;lt;question&amp;gt;"&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#cf222e"&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;comment_prompt&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="2036" width="680" height="271" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 4. Ghép prompt — generate_combined_prompts_one(db_path, question, knowledge)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;schema_prompt&lt;/font&gt; (bước 2), &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;comment_prompt&lt;/font&gt; (bước 3)&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Ghép chuỗi, phần đuôi khác nhau theo script:&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;openai_request.py&lt;/font&gt;: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;schema + '\n\n' + comment + '\nGenerate the SQL after thinking step by step: ' + '\nSELECT '&lt;/font&gt; (đúng như gpt_request.py gốc)&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;ollama_request.py&lt;/font&gt;: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;schema + '\n\n' + comment + '\nRespond with the final SQLite query only, inside a ```sql code block. Do not add any explanation.'&lt;/font&gt;&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--cot&lt;/font&gt;: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;generate_combined_prompts_cot&lt;/font&gt; = 1-shot ví dụ (few_shot / few_shot_no_kg) + schema + comment&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;prompt&lt;/font&gt; (string)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="2347" width="680" height="320" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c19" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 5. Gọi LLM — call_openai(client, model, prompt, max_retries=5, max_tokens=256)  /  call_ollama(model, prompt, max_retries=3, timeout=120)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;prompt&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;model&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;OpenAI:&lt;/b&gt; &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;client.chat.completions.create(model, messages=[{'role':'user','content':prompt}], temperature=0, max_tokens=256, stop=['--','\n\n',';','#'])&lt;/font&gt;; lỗi 429 (rate limit) → chờ rồi thử lại ≤ 5 lần&lt;br&gt;&lt;b&gt;Ollama:&lt;/b&gt; &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;requests.post(OLLAMA_URL, json={model, messages, stream: False, options:{temperature:0}}, timeout=120)&lt;/font&gt;; lỗi → chờ 3s, thử lại ≤ 3 lần&lt;br&gt;temperature=0 → luôn chọn token xác suất cao nhất → kết quả lặp lại được&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;raw&lt;/font&gt;: chuỗi model trả về (có thể kèm ```sql …```, &amp;lt;think&amp;gt;…&amp;lt;/think&amp;gt;, giải thích)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="2707" width="680" height="304" as="geometry"/></mxCell><mxCell id="c24" value="prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c21" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 6. Tách SQL — extract_sql(raw)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;raw&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;Ollama:&lt;/b&gt; xoá &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;&amp;lt;think&amp;gt;…&amp;lt;/think&amp;gt;&lt;/font&gt; → lấy nội dung khối &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;```sql … ```&lt;/font&gt; (không có thì bỏ fence mở) → cắt tại dấu &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;;&lt;/font&gt; đầu tiên → strip&lt;br&gt;&lt;b&gt;OpenAI:&lt;/b&gt; như trên, rồi bỏ &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;SELECT&lt;/font&gt; ở đầu (nếu có) và thêm lại &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;'SELECT '&lt;/font&gt; — mô phỏng code gốc &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;'SELECT' + completion_text&lt;/font&gt;&lt;br&gt;&lt;b&gt;--cot:&lt;/b&gt; &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;extract_sql_cot&lt;/font&gt; tách theo mốc &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;': SELECT'&lt;/font&gt;&lt;br&gt;Rỗng → trả &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;&quot;SELECT&quot;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;sql&lt;/font&gt; — 1 câu SQL sạch, không dấu ;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="3051" width="680" height="304" as="geometry"/></mxCell><mxCell id="c26" value="raw" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c23" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 7. Gắn tên CSDL + checkpoint&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;sql&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;db_id = basename(db_path).replace(&quot;.sqlite&quot;,&quot;&quot;)&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;response_list.append(sql + '\t----- bird -----\t' + db_id)&lt;/font&gt; — chuỗi phân cách này để &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;package_sqls&lt;/font&gt; ở bước chấm tách lại (sql, db_name)&lt;br&gt;Cứ &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;(i+1) % 50 == 0&lt;/font&gt; → ghi tạm &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;generate_sql_file&lt;/font&gt; (phòng mất phiên Kaggle)&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;1 phần tử của &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;response_list&lt;/font&gt; → quay lại vòng lặp với câu i+1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="3395" width="680" height="254" as="geometry"/></mxCell><mxCell id="c28" value="sql" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c25" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="i += 1 (đến khi i = 1533)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;fontColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c27" target="c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="40" y="3589"/><mxPoint x="40" y="1498"/></Array></mxGeometry></mxCell><mxCell id="c30" value="VÒNG LẶP — mỗi câu hỏi i = 0 … 1533" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=none;dashed=1;strokeColor=#888888;fontSize=13;fontStyle=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="1408" width="760" height="2261" as="geometry"/></mxCell><mxCell id="c31" value='&lt;div style="font-size:14px"&gt;&lt;b&gt;Bước 8. Ghi file — generate_sql_file(sql_lst, output_path)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#1a7f37"&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;response_list&lt;/font&gt; (đủ 1.534 phần tử), &lt;font face="Consolas" color="#1f4e79"&gt;args.data_output_path&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#9a6700"&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;result = {i: sql for i, sql in enumerate(sql_lst)}&lt;/font&gt;; tạo thư mục nếu chưa có; &lt;font face="Consolas" color="#1f4e79"&gt;json.dump(result, indent=4)&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#cf222e"&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;file &lt;font face="Consolas" color="#1f4e79"&gt;predict_dev.json&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="3719" width="760" height="221" as="geometry"/></mxCell><mxCell id="c32" value="hết vòng lặp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c27" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="&lt;b&gt;predict_dev.json&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;{&lt;br&gt;&amp;nbsp;&quot;0&quot;: &quot;SELECT … \t----- bird -----\tcalifornia_schools&quot;,&lt;br&gt;&amp;nbsp;…&lt;br&gt;&amp;nbsp;&quot;1379&quot;: &quot;SELECT COUNT(*) FROM event WHERE type = 'Meeting' AND STRFTIME('%Y', event_date) = '2020'\t----- bird -----\tstudent_club&quot;,&lt;br&gt;&amp;nbsp;…&lt;br&gt;&amp;nbsp;&quot;1533&quot;: &quot;…&quot;&lt;br&gt;}&lt;/font&gt;&lt;br&gt;Khoá = chỉ số câu trong dev.json → sang ③ chấm EX / VES" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;size=0.08;" vertex="1" parent="1"><mxGeometry x="170" y="3980" width="500" height="205" as="geometry"/></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c31" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="&lt;b&gt;VÍ DỤ: câu 1379 (student_club, simple)&lt;/b&gt;&lt;hr&gt;&lt;b&gt;Sau decouple_question_schema:&lt;/b&gt;&lt;br&gt;question = &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;How many meeting events were held in 2020?&lt;/font&gt;&lt;br&gt;db_path = &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;../data/dev_databases/student_club/student_club.sqlite&lt;/font&gt;&lt;br&gt;knowledge = &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;meeting events refers to type = 'Meeting'; held in 2020 refers to YEAR(event_date) = 2020&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="110" width="560" height="155" as="geometry"/></mxCell><mxCell id="c36" value='&lt;b&gt;schema_prompt (bước 2) — trích&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;CREATE TABLE event (&lt;br&gt;&amp;nbsp;event_id TEXT constraint event_pk primary key,&lt;br&gt;&amp;nbsp;event_name TEXT, event_date TEXT, type TEXT, notes TEXT, location TEXT, status TEXT)&lt;br&gt;&lt;br&gt;CREATE TABLE major (…)&lt;br&gt;… (8 bảng: event, major, zip_code, attendance, budget, expense, income, member)&lt;/font&gt;' style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="295" width="560" height="172" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Đuôi prompt — WITH knowledge&lt;/b&gt; (ollama_request.py)&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;-- External Knowledge: meeting events refers to type = 'Meeting'; held in 2020 refers to YEAR(event_date) = 2020&lt;br&gt;-- Using valid SQLite and understading External Knowledge, answer the following questions for the tables provided above.&lt;br&gt;-- How many meeting events were held in 2020?&lt;br&gt;Respond with the final SQLite query only, inside a ```sql code block. Do not add any explanation.&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="497" width="560" height="172" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Đuôi prompt — WITHOUT knowledge&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;-- Using valid SQLite, answer the following questions for the tables provided above.&lt;br&gt;-- How many meeting events were held in 2020?&lt;br&gt;Respond with the final SQLite query only, …&lt;/font&gt;&lt;br&gt;→ model phải tự đoán &quot;meeting events&quot; ↔ cột &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;type&lt;/font&gt; = &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;'Meeting'&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="699" width="560" height="139" as="geometry"/></mxCell><mxCell id="c39" value='&lt;b&gt;Đuôi prompt — openai_request.py (paper)&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;… -- How many meeting events were held in 2020?&lt;br&gt;Generate the SQL after thinking step by step: &lt;br&gt;SELECT &lt;/font&gt;' style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="868" width="560" height="106" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;raw (bước 5)&lt;/b&gt; — minh hoạ&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;```sql&lt;br&gt;SELECT COUNT(*) FROM event WHERE type = 'Meeting' AND STRFTIME('%Y', event_date) = '2020';&lt;br&gt;```&lt;/font&gt;&lt;hr&gt;&lt;b&gt;sql (bước 6)&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;SELECT COUNT(*) FROM event WHERE type = 'Meeting' AND STRFTIME('%Y', event_date) = '2020'&lt;/font&gt;&lt;hr&gt;&lt;b&gt;chuỗi lưu (bước 7)&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;&quot;…= '2020'\t----- bird -----\tstudent_club&quot;&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="1004" width="560" height="238" as="geometry"/></mxCell><mxCell id="c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;fontColor=#555555;" edge="1" parent="1" source="c6" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;fontColor=#555555;" edge="1" parent="1" source="c17" target="c36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;fontColor=#555555;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c21" target="c37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;fontColor=#555555;" edge="1" parent="1" source="c25" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c45" value='&lt;b&gt;BẢNG THAM SỐ GỌI LLM&lt;/b&gt;&lt;hr&gt;&lt;table border="1" cellpadding="3" style="border-collapse:collapse;font-size:11px"&gt;&lt;tr&gt;&lt;th&gt;Tham số&lt;/th&gt;&lt;th&gt;OpenAI&lt;/th&gt;&lt;th&gt;Ollama&lt;/th&gt;&lt;th&gt;Ý nghĩa&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;temperature&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;tất định&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;max_tokens&lt;/td&gt;&lt;td&gt;256 (CoT 1024)&lt;/td&gt;&lt;td&gt;mặc định&lt;/td&gt;&lt;td&gt;giới hạn độ dài (như paper)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;stop&lt;/td&gt;&lt;td&gt;-- , \n\n , ; , #&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;dừng khi hết câu SQL (như paper)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;retry&lt;/td&gt;&lt;td&gt;5 (lỗi 429)&lt;/td&gt;&lt;td&gt;3 (chờ 3s)&lt;/td&gt;&lt;td&gt;chống lỗi mạng/rate limit&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;timeout&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;120 s&lt;/td&gt;&lt;td&gt;mỗi lần gọi&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="1302" width="560" height="270" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="2b. Chấm EX (evaluation.py)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="3200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="③ CHẤM EX — Execution Accuracy (evaluation.py)" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1900" height="40" as="geometry"/></mxCell><mxCell id="c2" value='Script gốc của BIRD, không sửa (&lt;font face="Consolas" color="#1f4e79"&gt;bird/llm/src/evaluation.py&lt;/font&gt;). Chạy 2 lần cho mỗi model: thư mục &lt;font face="Consolas" color="#1f4e79"&gt;*_output/&lt;/font&gt; → &lt;b&gt;EX with knowledge&lt;/b&gt;; thư mục &lt;font face="Consolas" color="#1f4e79"&gt;*_0_output/&lt;/font&gt; → &lt;b&gt;EX without knowledge&lt;/b&gt;.' style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;div style="font-size:14px"&gt;&lt;b&gt;Bước 1. Chạy lệnh — main (argparse)&lt;/b&gt;&lt;/div&gt;&lt;font color="#666666"&gt;&lt;i&gt;evaluation.py&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#1a7f37"&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;python src/evaluation.py --predicted_sql_path ./exp_result/openai_output/ --ground_truth_path ./data/ --data_mode dev --db_root_path ../data/dev_databases/ --diff_json_path ../data/dev.json --num_cpus 8 --meta_time_out 30.0&lt;/font&gt;&lt;br&gt;• &lt;font face="Consolas" color="#1f4e79"&gt;--predicted_sql_path&lt;/font&gt;: thư mục chứa predict_dev.json (phải có / cuối vì code nối chuỗi)&lt;br&gt;• &lt;font face="Consolas" color="#1f4e79"&gt;--ground_truth_path&lt;/font&gt;: thư mục chứa dev_gold.sql&lt;br&gt;• &lt;font face="Consolas" color="#1f4e79"&gt;--data_mode dev&lt;/font&gt;: ghép tên file &lt;font face="Consolas" color="#1f4e79"&gt;predict_dev.json&lt;/font&gt;, &lt;font face="Consolas" color="#1f4e79"&gt;dev_gold.sql&lt;/font&gt;&lt;br&gt;• &lt;font face="Consolas" color="#1f4e79"&gt;--db_root_path&lt;/font&gt;: thư mục 11 CSDL&lt;br&gt;• &lt;font face="Consolas" color="#1f4e79"&gt;--diff_json_path&lt;/font&gt;: dev.json — chỉ để lấy &lt;font face="Consolas" color="#1f4e79"&gt;difficulty&lt;/font&gt;&lt;br&gt;• &lt;font face="Consolas" color="#1f4e79"&gt;--num_cpus&lt;/font&gt;: số tiến trình song song · &lt;font face="Consolas" color="#1f4e79"&gt;--meta_time_out&lt;/font&gt;: giây tối đa/câu&lt;br&gt;• &lt;font face="Consolas" color="#1f4e79"&gt;--mode_predict gpt&lt;/font&gt; / &lt;font face="Consolas" color="#1f4e79"&gt;--mode_gt gt&lt;/font&gt;: cách đọc file&lt;hr&gt;&lt;b&gt;&lt;font color="#9a6700"&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Khởi tạo biến toàn cục &lt;font face="Consolas" color="#1f4e79"&gt;exec_result = []&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#cf222e"&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;args&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="800" height="353" as="geometry"/></mxCell><mxCell id="c4" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 2a. package_sqls(predicted_sql_path, db_root_path, mode='gpt', data_mode='dev')&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;predict_dev.json&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Với mỗi (idx, sql_str): &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;sql, db_name = sql_str.split('\t----- bird -----\t')&lt;/font&gt;; nếu giá trị không phải str → (&quot; &quot;, &quot;financial&quot;); &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;db_path = db_root_path + db_name + '/' + db_name + '.sqlite'&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;pred_queries&lt;/font&gt; (1.534 SQL), &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;db_paths&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="513" width="380" height="287" as="geometry"/></mxCell><mxCell id="c5" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 2b. package_sqls(ground_truth_path, db_root_path, mode='gt', data_mode='dev')&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;dev_gold.sql&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Đọc từng dòng: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;sql, db_name = line.strip().split('\t')&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;gt_queries&lt;/font&gt; (1.534 SQL), &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;db_paths_gt&lt;/font&gt; (không dùng)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="513" width="380" height="238" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value='&lt;div style="font-size:14px"&gt;&lt;b&gt;Bước 3. query_pairs = list(zip(pred_queries, gt_queries))&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#9a6700"&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Ghép cặp theo chỉ số i&lt;hr&gt;&lt;b&gt;&lt;font color="#cf222e"&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;[(pred_0, gold_0), …, (pred_1533, gold_1533)]&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="850" width="400" height="172" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value='&lt;div style="font-size:14px"&gt;&lt;b&gt;Bước 4–5. run_sqls_parallel(sqls, db_places, num_cpus, meta_time_out)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#1a7f37"&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;query_pairs&lt;/font&gt;, &lt;font face="Consolas" color="#1f4e79"&gt;db_paths&lt;/font&gt; (của pred), &lt;font face="Consolas" color="#1f4e79"&gt;num_cpus&lt;/font&gt;, &lt;font face="Consolas" color="#1f4e79"&gt;meta_time_out&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#9a6700"&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;pool = mp.Pool(num_cpus)&lt;/font&gt;; với mỗi cặp i: &lt;font face="Consolas" color="#1f4e79"&gt;pool.apply_async(execute_model, args=(pred, gold, db_paths[i], i, meta_time_out), callback=result_callback)&lt;/font&gt;; &lt;font face="Consolas" color="#1f4e79"&gt;pool.close(); pool.join()&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#cf222e"&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Không trả về; &lt;font face="Consolas" color="#1f4e79"&gt;result_callback&lt;/font&gt; append từng kết quả vào &lt;font face="Consolas" color="#1f4e79"&gt;exec_result&lt;/font&gt; (thứ tự lộn xộn)' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1072" width="800" height="238" as="geometry"/></mxCell><mxCell id="c12" value="query_pairs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 4. execute_model(predicted_sql, ground_truth, db_place, idx, meta_time_out)&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;chạy trong 1 tiến trình con&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;cặp SQL thứ idx + đường dẫn CSDL&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;res = func_timeout(meta_time_out, execute_sql, args=(predicted_sql, ground_truth, db_place))&lt;/font&gt;&lt;br&gt;Hết giờ (&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;FunctionTimedOut&lt;/font&gt;) → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;res = 0&lt;/font&gt;; SQL lỗi cú pháp / sai tên cột (Exception) → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;res = 0&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;{'sql_idx': idx, 'res': 0 | 1}&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="1370" width="740" height="238" as="geometry"/></mxCell><mxCell id="c14" value='&lt;div style="font-size:14px"&gt;&lt;b&gt;Bước 5. execute_sql(predicted_sql, ground_truth, db_path)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#1a7f37"&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;cặp SQL, &lt;font face="Consolas" color="#1f4e79"&gt;db_path&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#9a6700"&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;conn = sqlite3.connect(db_path)&lt;/font&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;cursor.execute(predicted_sql); predicted_res = cursor.fetchall()&lt;/font&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;cursor.execute(ground_truth); ground_truth_res = cursor.fetchall()&lt;/font&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;res = 1 if set(predicted_res) == set(ground_truth_res) else 0&lt;/font&gt;&lt;br&gt;→ so &lt;b&gt;tập&lt;/b&gt; các dòng: không xét thứ tự dòng, dòng trùng, tên cột; nhưng thứ tự/số cột trong mỗi dòng phải khớp&lt;hr&gt;&lt;b&gt;&lt;font color="#cf222e"&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;res&lt;/font&gt; ∈ {0, 1}' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="1648" width="680" height="304" as="geometry"/></mxCell><mxCell id="c15" value="mỗi cặp i (song song)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="callback → exec_result.append(result)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;fontColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860" y="1912"/><mxPoint x="860" y="1270"/></Array></mxGeometry></mxCell><mxCell id="c18" value="MULTIPROCESSING POOL — 1.534 tác vụ" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=none;dashed=1;strokeColor=#888888;fontSize=13;fontStyle=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="50" y="1330" width="780" height="642" as="geometry"/></mxCell><mxCell id="c19" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 6. sort_results(exec_result)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;exec_result&lt;/font&gt; (thứ tự hoàn thành)&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;sorted(list, key=lambda x: x['sql_idx'])&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;list 1.534 kết quả theo đúng thứ tự dev.json" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="2012" width="800" height="221" as="geometry"/></mxCell><mxCell id="c20" value="pool.join()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 7. compute_acc_by_diff(exec_results, diff_json_path)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;exec_result&lt;/font&gt; đã sắp xếp, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;dev.json&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Chia kết quả theo &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;content['difficulty']&lt;/font&gt; (simple / moderate / challenging).&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;acc_nhóm = Σ res / số câu của nhóm;  all_acc = Σ res / 1534&lt;/font&gt;; nhân 100&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;simple_acc, moderate_acc, challenging_acc, all_acc&lt;/font&gt; (%), &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;count_lists = [925, 464, 145, 1534]&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="2273" width="800" height="238" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c19" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value='&lt;div style="font-size:14px"&gt;&lt;b&gt;Bước 7. print_data(score_lists, count_lists)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#1a7f37"&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;4 điểm + 4 số lượng&lt;hr&gt;&lt;b&gt;&lt;font color="#9a6700"&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;In bảng ra console&lt;hr&gt;&lt;b&gt;&lt;font color="#cf222e"&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;simple&amp;nbsp;&amp;nbsp;moderate&amp;nbsp;&amp;nbsp;challenging&amp;nbsp;&amp;nbsp;total&lt;br&gt;count&amp;nbsp;&amp;nbsp;&amp;nbsp;925&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;464&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;145&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;1534&lt;br&gt;accuracy&amp;nbsp;…&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="2551" width="800" height="271" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c21" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="&lt;b&gt;CÔNG THỨC EX&lt;/b&gt;&lt;hr&gt;EX = (1/N) · Σ&lt;sub&gt;n&lt;/sub&gt; 𝟙(V̂&lt;sub&gt;n&lt;/sub&gt; = V&lt;sub&gt;n&lt;/sub&gt;) × 100&lt;br&gt;V̂ = tập kết quả của SQL dự đoán, V = tập kết quả của gold SQL, N = 1.534&lt;br&gt;&lt;hr&gt;&lt;b&gt;Các trường hợp res = 0:&lt;/b&gt;&lt;br&gt;• kết quả khác gold&lt;br&gt;• SQL lỗi (no such column / function, syntax…)&lt;br&gt;• chạy quá &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;meta_time_out&lt;/font&gt; giây&lt;br&gt;• SQL rỗng &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;&quot;SELECT&quot;&lt;/font&gt; (do lỗi gọi model)&lt;br&gt;&lt;hr&gt;&lt;b&gt;Ví dụ câu 1379:&lt;/b&gt; pred &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;COUNT(*) … STRFTIME('%Y', event_date) = '2020'&lt;/font&gt; và gold &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;COUNT(event_id) … SUBSTR(event_date,1,4) = '2020'&lt;/font&gt; cùng trả [(n,)] → res = 1" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="920" y="110" width="560" height="287" as="geometry"/></mxCell><mxCell id="c26" value='&lt;b&gt;CHẠY 2 TRƯỜNG HỢP&lt;/b&gt;&lt;hr&gt;&lt;b&gt;EX with knowledge:&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;--predicted_sql_path ./exp_result/openai_output/&lt;/font&gt;&lt;br&gt;&lt;b&gt;EX without knowledge:&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;--predicted_sql_path ./exp_result/openai_0_output/&lt;/font&gt;&lt;br&gt;&lt;hr&gt;Các model khác: &lt;font face="Consolas" color="#1f4e79"&gt;ollama_deepseekcoder_output/&lt;/font&gt; + &lt;font face="Consolas" color="#1f4e79"&gt;ollama_deepseekcoder_0_output/&lt;/font&gt;, &lt;font face="Consolas" color="#1f4e79"&gt;ollama_gwen25_output/&lt;/font&gt; + &lt;font face="Consolas" color="#1f4e79"&gt;_0_output/&lt;/font&gt;, &lt;font face="Consolas" color="#1f4e79"&gt;ollama_gemma3_output/&lt;/font&gt; + &lt;font face="Consolas" color="#1f4e79"&gt;_0_output/&lt;/font&gt;&lt;br&gt;Gold, CSDL, dev.json giữ nguyên ở mọi lượt — chỉ đổi thư mục dự đoán.' style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="920" y="520" width="560" height="221" as="geometry"/></mxCell><mxCell id="c27" value='&lt;b&gt;MỞ RỘNG: chấm theo 6 mức SQL&lt;/b&gt; — &lt;font face="Consolas" color="#1f4e79"&gt;app/scripts/ex_ves_by_category.py&lt;/font&gt;&lt;hr&gt;Import lại &lt;font face="Consolas" color="#1f4e79"&gt;evaluation.package_sqls / execute_model&lt;/font&gt; và &lt;font face="Consolas" color="#1f4e79"&gt;evaluation_ves.execute_model / compute_ves&lt;/font&gt;; &lt;font face="Consolas" color="#1f4e79"&gt;classify(gold)&lt;/font&gt; để chia câu vào mức 1–6; gọi thẳng &lt;font face="Consolas" color="#1f4e79"&gt;execute_model&lt;/font&gt; từng câu (tránh chia 0 của compute_acc_by_diff khi tập con thiếu một độ khó) → &lt;font face="Consolas" color="#1f4e79"&gt;ex_ves_by_category_&amp;lt;db&amp;gt;.csv / .xlsx&lt;/font&gt;' style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="920" y="780" width="560" height="139" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="2c. Chấm VES (evaluation_ves.py)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="3200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="③ CHẤM VES — Valid Efficiency Score (evaluation_ves.py)" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1900" height="40" as="geometry"/></mxCell><mxCell id="c2" value='Script gốc của BIRD, không sửa (&lt;font face="Consolas" color="#1f4e79"&gt;bird/llm/src/evaluation_ves.py&lt;/font&gt;). Chạy 2 lần cho mỗi model: thư mục &lt;font face="Consolas" color="#1f4e79"&gt;*_output/&lt;/font&gt; → &lt;b&gt;VES with knowledge&lt;/b&gt;; thư mục &lt;font face="Consolas" color="#1f4e79"&gt;*_0_output/&lt;/font&gt; → &lt;b&gt;VES without knowledge&lt;/b&gt;.' style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1900" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;div style="font-size:14px"&gt;&lt;b&gt;Bước 1. Chạy lệnh — main (argparse)&lt;/b&gt;&lt;/div&gt;&lt;font color="#666666"&gt;&lt;i&gt;evaluation_ves.py&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#1a7f37"&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;python src/evaluation_ves.py --predicted_sql_path ./exp_result/openai_output/ --ground_truth_path ./data/ --data_mode dev --db_root_path ../data/dev_databases/ --diff_json_path ../data/dev.json --num_cpus 8 --meta_time_out 30.0 --iterate_num 5&lt;/font&gt;&lt;br&gt;• &lt;font face="Consolas" color="#1f4e79"&gt;--predicted_sql_path&lt;/font&gt;: thư mục chứa predict_dev.json (phải có / cuối vì code nối chuỗi)&lt;br&gt;• &lt;font face="Consolas" color="#1f4e79"&gt;--ground_truth_path&lt;/font&gt;: thư mục chứa dev_gold.sql&lt;br&gt;• &lt;font face="Consolas" color="#1f4e79"&gt;--data_mode dev&lt;/font&gt;: ghép tên file &lt;font face="Consolas" color="#1f4e79"&gt;predict_dev.json&lt;/font&gt;, &lt;font face="Consolas" color="#1f4e79"&gt;dev_gold.sql&lt;/font&gt;&lt;br&gt;• &lt;font face="Consolas" color="#1f4e79"&gt;--db_root_path&lt;/font&gt;: thư mục 11 CSDL&lt;br&gt;• &lt;font face="Consolas" color="#1f4e79"&gt;--diff_json_path&lt;/font&gt;: dev.json — chỉ để lấy &lt;font face="Consolas" color="#1f4e79"&gt;difficulty&lt;/font&gt;&lt;br&gt;• &lt;font face="Consolas" color="#1f4e79"&gt;--num_cpus&lt;/font&gt;: số tiến trình song song · &lt;font face="Consolas" color="#1f4e79"&gt;--meta_time_out&lt;/font&gt;: giây tối đa/câu&lt;br&gt;• &lt;font face="Consolas" color="#1f4e79"&gt;--mode_predict gpt&lt;/font&gt; / &lt;font face="Consolas" color="#1f4e79"&gt;--mode_gt gt&lt;/font&gt;: cách đọc file&lt;br&gt;• &lt;font face="Consolas" color="#1f4e79"&gt;--iterate_num 5&lt;/font&gt;: số lần chạy lại mỗi câu để đo thời gian (paper dùng 5; phải ≥ 2)&lt;hr&gt;&lt;b&gt;&lt;font color="#9a6700"&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Khởi tạo biến toàn cục &lt;font face="Consolas" color="#1f4e79"&gt;exec_result = []&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#cf222e"&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;args&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="800" height="386" as="geometry"/></mxCell><mxCell id="c4" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 2a. package_sqls(predicted_sql_path, db_root_path, mode='gpt', data_mode='dev')&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;predict_dev.json&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Với mỗi (idx, sql_str): &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;sql, db_name = sql_str.split('\t----- bird -----\t')&lt;/font&gt;; nếu giá trị không phải str → (&quot; &quot;, &quot;financial&quot;); &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;db_path = db_root_path + db_name + '/' + db_name + '.sqlite'&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;pred_queries&lt;/font&gt; (1.534 SQL), &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;db_paths&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="546" width="380" height="287" as="geometry"/></mxCell><mxCell id="c5" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 2b. package_sqls(ground_truth_path, db_root_path, mode='gt', data_mode='dev')&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;dev_gold.sql&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Đọc từng dòng: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;sql, db_name = line.strip().split('\t')&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;gt_queries&lt;/font&gt; (1.534 SQL), &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;db_paths_gt&lt;/font&gt; (không dùng)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="546" width="380" height="238" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value='&lt;div style="font-size:14px"&gt;&lt;b&gt;Bước 3. query_pairs = list(zip(pred_queries, gt_queries))&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#9a6700"&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Ghép cặp theo chỉ số i&lt;hr&gt;&lt;b&gt;&lt;font color="#cf222e"&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;[(pred_0, gold_0), …, (pred_1533, gold_1533)]&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="883" width="400" height="172" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value='&lt;div style="font-size:14px"&gt;&lt;b&gt;Bước 4–6. run_sqls_parallel(sqls, db_places, num_cpus, iterate_num, meta_time_out)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#1a7f37"&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;query_pairs&lt;/font&gt;, &lt;font face="Consolas" color="#1f4e79"&gt;db_paths&lt;/font&gt; (của pred), &lt;font face="Consolas" color="#1f4e79"&gt;num_cpus&lt;/font&gt;, &lt;font face="Consolas" color="#1f4e79"&gt;iterate_num&lt;/font&gt;, &lt;font face="Consolas" color="#1f4e79"&gt;meta_time_out&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#9a6700"&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;pool = mp.Pool(num_cpus)&lt;/font&gt;; với mỗi cặp i: &lt;font face="Consolas" color="#1f4e79"&gt;pool.apply_async(execute_model, args=(pred, gold, db_paths[i], i, iterate_num, meta_time_out), callback=result_callback)&lt;/font&gt;; &lt;font face="Consolas" color="#1f4e79"&gt;pool.close(); pool.join()&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#cf222e"&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Không trả về; &lt;font face="Consolas" color="#1f4e79"&gt;result_callback&lt;/font&gt; append từng kết quả vào &lt;font face="Consolas" color="#1f4e79"&gt;exec_result&lt;/font&gt; (thứ tự lộn xộn)' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1105" width="800" height="238" as="geometry"/></mxCell><mxCell id="c12" value="query_pairs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 4. execute_model(predicted_sql, ground_truth, db_place, idx, iterate_num, meta_time_out)&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;chạy trong 1 tiến trình con&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;cặp SQL thứ idx + đường dẫn CSDL&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;time_ratio = func_timeout(meta_time_out * iterate_num, iterated_execute_sql, args=(…))&lt;/font&gt;&lt;br&gt;Hết giờ (&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;FunctionTimedOut&lt;/font&gt;) → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;time_ratio = 0&lt;/font&gt;; SQL lỗi (Exception) → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;time_ratio = 0&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;{'sql_idx': idx, 'time_ratio': số thực ≥ 0}&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="1403" width="740" height="238" as="geometry"/></mxCell><mxCell id="c14" value='&lt;div style="font-size:14px"&gt;&lt;b&gt;Bước 4–6. iterated_execute_sql(predicted_sql, ground_truth, db_path, iterate_num)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#1a7f37"&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;cặp SQL, &lt;font face="Consolas" color="#1f4e79"&gt;db_path&lt;/font&gt;, &lt;font face="Consolas" color="#1f4e79"&gt;iterate_num&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#9a6700"&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;1. &lt;font face="Consolas" color="#1f4e79"&gt;sqlite3.connect(db_path)&lt;/font&gt;; chạy pred → &lt;font face="Consolas" color="#1f4e79"&gt;fetchall()&lt;/font&gt;; chạy gold → &lt;font face="Consolas" color="#1f4e79"&gt;fetchall()&lt;/font&gt;&lt;br&gt;2. Nếu &lt;font face="Consolas" color="#1f4e79"&gt;set(pred_res) != set(gold_res)&lt;/font&gt; → &lt;font face="Consolas" color="#1f4e79"&gt;time_ratio = 0&lt;/font&gt; (câu sai, không đo thời gian)&lt;br&gt;3. Nếu đúng: lặp &lt;font face="Consolas" color="#1f4e79"&gt;iterate_num&lt;/font&gt; lần: &lt;font face="Consolas" color="#1f4e79"&gt;t_pred = execute_sql(pred)&lt;/font&gt;, &lt;font face="Consolas" color="#1f4e79"&gt;t_gold = execute_sql(gold)&lt;/font&gt;, &lt;font face="Consolas" color="#1f4e79"&gt;diff_list.append(t_gold / t_pred)&lt;/font&gt;&lt;br&gt;4. &lt;font face="Consolas" color="#1f4e79"&gt;processed = clean_abnormal(diff_list)&lt;/font&gt;; &lt;font face="Consolas" color="#1f4e79"&gt;time_ratio = mean(processed)&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#cf222e"&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;time_ratio&lt;/font&gt; (R &gt; 1: pred nhanh hơn gold; R &lt; 1: chậm hơn)' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="1681" width="680" height="287" as="geometry"/></mxCell><mxCell id="c15" value='&lt;div style="font-size:14px"&gt;&lt;b&gt;Bước 5. execute_sql(sql, db_path)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#1a7f37"&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;một câu SQL&lt;hr&gt;&lt;b&gt;&lt;font color="#9a6700"&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;start = time.time(); cursor.execute(sql); exec_time = time.time() - start&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#cf222e"&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;số giây' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="130" y="2008" width="300" height="238" as="geometry"/></mxCell><mxCell id="c16" value='&lt;div style="font-size:14px"&gt;&lt;b&gt;Bước 6. clean_abnormal(input)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#1a7f37"&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;diff_list&lt;/font&gt; (iterate_num tỉ lệ)&lt;hr&gt;&lt;b&gt;&lt;font color="#9a6700"&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;mean, std; giữ x nếu &lt;font face="Consolas" color="#1f4e79"&gt;mean − 3·std &amp;lt; x &amp;lt; mean + 3·std&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#cf222e"&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;list đã lọc ngoại lai' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="2008" width="320" height="238" as="geometry"/></mxCell><mxCell id="c17" value="mỗi cặp i (song song)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="×2·iterate_num" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="callback → exec_result.append(result)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;fontColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860" y="2206"/><mxPoint x="860" y="1303"/></Array></mxGeometry></mxCell><mxCell id="c22" value="MULTIPROCESSING POOL — 1.534 tác vụ" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=none;dashed=1;strokeColor=#888888;fontSize=13;fontStyle=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="50" y="1363" width="780" height="903" as="geometry"/></mxCell><mxCell id="c23" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 7. sort_results(exec_result)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;exec_result&lt;/font&gt; (thứ tự hoàn thành)&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;sorted(list, key=lambda x: x['sql_idx'])&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;list 1.534 kết quả theo đúng thứ tự dev.json" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="2306" width="800" height="221" as="geometry"/></mxCell><mxCell id="c24" value="pool.join()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 8. compute_ves_by_diff(exec_results, diff_json_path)  →  compute_ves(results)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;exec_result&lt;/font&gt; đã sắp xếp, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;dev.json&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Chia kết quả theo &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;content['difficulty']&lt;/font&gt; của dev.json (cùng chỉ số i). Với mỗi nhóm gọi &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;compute_ves&lt;/font&gt;:&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;total_ratio = Σ sqrt(time_ratio) × 100;  ves = total_ratio / số câu của nhóm&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;simple_ves, moderate_ves, challenging_ves, all_ves, count_lists&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="2567" width="800" height="238" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c23" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value='&lt;div style="font-size:14px"&gt;&lt;b&gt;Bước 8. print_data(score_lists, count_lists)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#1a7f37"&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;4 điểm + 4 số lượng&lt;hr&gt;&lt;b&gt;&lt;font color="#9a6700"&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;In bảng ra console&lt;hr&gt;&lt;b&gt;&lt;font color="#cf222e"&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;simple&amp;nbsp;&amp;nbsp;moderate&amp;nbsp;&amp;nbsp;challenging&amp;nbsp;&amp;nbsp;total&lt;br&gt;count&amp;nbsp;&amp;nbsp;&amp;nbsp;925&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;464&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;145&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;1534&lt;br&gt;ves&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;…&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="2845" width="800" height="271" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c25" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="&lt;b&gt;CÔNG THỨC VES&lt;/b&gt;&lt;hr&gt;VES = (1/N) · Σ&lt;sub&gt;n&lt;/sub&gt; 𝟙(V̂&lt;sub&gt;n&lt;/sub&gt; = V&lt;sub&gt;n&lt;/sub&gt;) · √R(Ŷ&lt;sub&gt;n&lt;/sub&gt;, Y&lt;sub&gt;n&lt;/sub&gt;) × 100&lt;br&gt;R = trung bình (t_gold / t_pred) sau khi lọc ngoại lai&lt;br&gt;&lt;hr&gt;&lt;b&gt;Đóng góp của 1 câu:&lt;/b&gt;&lt;br&gt;• sai / lỗi / timeout → 0&lt;br&gt;• đúng, nhanh bằng gold (R=1) → 100&lt;br&gt;• đúng, nhanh gấp 4 lần (R=4) → 200&lt;br&gt;• đúng, chậm gấp 4 lần (R=0.25) → 50&lt;br&gt;&lt;hr&gt;Lưu ý: phụ thuộc thời gian chạy thực → dao động nhẹ giữa các lần chấm; VES có thể &gt; EX nếu SQL sinh ra chạy nhanh hơn gold." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="920" y="110" width="560" height="287" as="geometry"/></mxCell><mxCell id="c30" value='&lt;b&gt;CHẠY 2 TRƯỜNG HỢP&lt;/b&gt;&lt;hr&gt;&lt;b&gt;VES with knowledge:&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;--predicted_sql_path ./exp_result/openai_output/&lt;/font&gt;&lt;br&gt;&lt;b&gt;VES without knowledge:&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;--predicted_sql_path ./exp_result/openai_0_output/&lt;/font&gt;&lt;br&gt;&lt;hr&gt;Các model khác: &lt;font face="Consolas" color="#1f4e79"&gt;ollama_deepseekcoder_output/&lt;/font&gt; + &lt;font face="Consolas" color="#1f4e79"&gt;ollama_deepseekcoder_0_output/&lt;/font&gt;, &lt;font face="Consolas" color="#1f4e79"&gt;ollama_gwen25_output/&lt;/font&gt; + &lt;font face="Consolas" color="#1f4e79"&gt;_0_output/&lt;/font&gt;, &lt;font face="Consolas" color="#1f4e79"&gt;ollama_gemma3_output/&lt;/font&gt; + &lt;font face="Consolas" color="#1f4e79"&gt;_0_output/&lt;/font&gt;&lt;br&gt;Gold, CSDL, dev.json giữ nguyên ở mọi lượt — chỉ đổi thư mục dự đoán.' style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="920" y="520" width="560" height="221" as="geometry"/></mxCell><mxCell id="c31" value='&lt;b&gt;MỞ RỘNG: chấm theo 6 mức SQL&lt;/b&gt; — &lt;font face="Consolas" color="#1f4e79"&gt;app/scripts/ex_ves_by_category.py&lt;/font&gt;&lt;hr&gt;Import lại &lt;font face="Consolas" color="#1f4e79"&gt;evaluation.package_sqls / execute_model&lt;/font&gt; và &lt;font face="Consolas" color="#1f4e79"&gt;evaluation_ves.execute_model / compute_ves&lt;/font&gt;; &lt;font face="Consolas" color="#1f4e79"&gt;classify(gold)&lt;/font&gt; để chia câu vào mức 1–6; gọi thẳng &lt;font face="Consolas" color="#1f4e79"&gt;execute_model&lt;/font&gt; từng câu (tránh chia 0 của compute_acc_by_diff khi tập con thiếu một độ khó) → &lt;font face="Consolas" color="#1f4e79"&gt;ex_ves_by_category_&amp;lt;db&amp;gt;.csv / .xlsx&lt;/font&gt;' style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="920" y="780" width="560" height="139" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="2d. Ma trận chạy &amp; Bảng kết quả"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="④ MA TRẬN CHẠY &amp; BẢNG KẾT QUẢ CUỐI CÙNG" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="40" as="geometry"/></mxCell><mxCell id="c2" value='&lt;div style="font-size:14px"&gt;&lt;b&gt;Vòng ngoài: for model in MODELS&lt;/b&gt;&lt;/div&gt;&lt;font color="#666666"&gt;&lt;i&gt;Kaggle notebook / terminal&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#1a7f37"&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;MODELS = [gpt-3.5-turbo, deepseek-coder-v2:16b, qwen2.5-coder:7b, gemma3:12b, (gpt-oss-20b/120b qua Groq…)]&lt;hr&gt;&lt;b&gt;&lt;font color="#9a6700"&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Với mỗi model chạy 2 cấu hình (with / without knowledge) qua luồng ② → mỗi cấu hình 1 file predict_dev.json&lt;hr&gt;&lt;b&gt;&lt;font color="#cf222e"&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;8–10 file predict_dev.json' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="520" height="254" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;with knowledge&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;python src/ollama_request2.py --model qwen2.5-coder:7b --data_output_path exp_result/ollama_gwen25_output/predict_dev.json&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="394" width="250" height="122" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;without knowledge&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;python src/ollama_request2.py --model qwen2.5-coder:7b --no_knowledge --data_output_path exp_result/ollama_gwen25_0_output/predict_dev.json&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="394" width="250" height="139" as="geometry"/></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value='&lt;b&gt;Chấm mỗi thư mục&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;evaluation.py&lt;/font&gt; → EX · &lt;font face="Consolas" color="#1f4e79"&gt;evaluation_ves.py --iterate_num 5&lt;/font&gt; → VES&lt;br&gt;(notebook &lt;font face="Consolas" color="#1f4e79"&gt;run-evaluation-kaggle.ipynb&lt;/font&gt;, &lt;font face="Consolas" color="#1f4e79"&gt;evaluation-and-ves-local.ipynb&lt;/font&gt;)' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="583" width="520" height="89" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value='&lt;b&gt;Tổng hợp&lt;/b&gt; → &lt;font face="Consolas" color="#1f4e79"&gt;exp_result/summary_ex_ves.csv&lt;/font&gt;&lt;br&gt;cột: Model, EX_wo_knowledge, EX_w_knowledge, VES_wo_knowledge, VES_w_knowledge' style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;size=0.08;" vertex="1" parent="1"><mxGeometry x="40" y="722" width="520" height="89" as="geometry"/></mxCell><mxCell id="c11" value="4 số / model" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value='&lt;b&gt;BẢNG KẾT QUẢ (dev 1.534 câu)&lt;/b&gt;&lt;hr&gt;&lt;table border="1" cellpadding="5" style="border-collapse:collapse;font-size:12px"&gt;&lt;tr style="background:#eeeeee"&gt;&lt;th&gt;Model&lt;/th&gt;&lt;th&gt;EX w/o KG&lt;/th&gt;&lt;th&gt;EX w/ KG&lt;/th&gt;&lt;th&gt;VES w/o KG&lt;/th&gt;&lt;th&gt;VES w/ KG&lt;/th&gt;&lt;th&gt;Nguồn&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ChatGPT (paper BIRD, Table 2)&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;37.22 (bản dev sửa 09/2023: 42.24)&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;paper / leaderboard&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;GPT-3.5-Turbo&lt;/b&gt; (tái lập)&lt;/td&gt;&lt;td&gt;31.23&lt;/td&gt;&lt;td&gt;47.78&lt;/td&gt;&lt;td&gt;33.88&lt;/td&gt;&lt;td&gt;53.88&lt;/td&gt;&lt;td&gt;summary_ex_ves.csv&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;DeepSeek-Coder-V2 (Ollama)&lt;/td&gt;&lt;td&gt;…&lt;/td&gt;&lt;td&gt;42.11&lt;/td&gt;&lt;td&gt;…&lt;/td&gt;&lt;td&gt;45.80&lt;/td&gt;&lt;td&gt;gap3 ctrl&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Qwen2.5-Coder (Ollama)&lt;/td&gt;&lt;td&gt;…&lt;/td&gt;&lt;td&gt;53.85&lt;/td&gt;&lt;td&gt;…&lt;/td&gt;&lt;td&gt;59.83&lt;/td&gt;&lt;td&gt;gap3 ctrl&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Gemma3 (Ollama)&lt;/td&gt;&lt;td&gt;…&lt;/td&gt;&lt;td&gt;48.70&lt;/td&gt;&lt;td&gt;…&lt;/td&gt;&lt;td&gt;54.86&lt;/td&gt;&lt;td&gt;gap3 ctrl&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;gpt-oss (Groq) / Gemini…&lt;/td&gt;&lt;td&gt;…&lt;/td&gt;&lt;td&gt;…&lt;/td&gt;&lt;td&gt;…&lt;/td&gt;&lt;td&gt;…&lt;/td&gt;&lt;td&gt;chưa chạy đủ&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;b&gt;…&lt;/b&gt; = điền sau khi chấm thư mục &lt;font face="Consolas" color="#1f4e79"&gt;*_0_output/&lt;/font&gt; tương ứng. Số "gap3 ctrl" là lượt w/ KG với evidence gốc, đã sửa prompt (PROJECT_LOG mục 8.1).&lt;hr&gt;&lt;b&gt;Nhận xét mong đợi:&lt;/b&gt; w/ KG &amp;gt; w/o KG rõ rệt (GPT-3.5: +16.55 EX, +20.00 VES) → evidence là yếu tố then chốt; model code mở 7B–16B chạy local đã ngang/vượt GPT-3.5.' style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="90" width="1180" height="254" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="3. Luồng Text-to-SQL (ClubQuery)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="4600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="⑤ LUỒNG TEXT-TO-SQL — ứng dụng ClubQuery (1 câu hỏi → SQL → chạy → trả lời → UI)" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2000" height="40" as="geometry"/></mxCell><mxCell id="c2" value='Code: &lt;font face="Consolas" color="#1f4e79"&gt;app/frontend/app.js&lt;/font&gt; → &lt;font face="Consolas" color="#1f4e79"&gt;app/backend/main.py&lt;/font&gt; → &lt;font face="Consolas" color="#1f4e79"&gt;service.py&lt;/font&gt; → &lt;font face="Consolas" color="#1f4e79"&gt;prompt.py, llm.py, guard.py, answer.py&lt;/font&gt;. CSDL nghiệp vụ: &lt;font face="Consolas" color="#1f4e79"&gt;student_club.sqlite&lt;/font&gt;; CSDL ứng dụng: &lt;font face="Consolas" color="#1f4e79"&gt;app/data/app.sqlite&lt;/font&gt; (user, model_config, dev_question, benchmark_run/item, glossary_term, query_log).' style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="2000" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 1. Người dùng đặt câu hỏi trên UI&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;app/frontend/app.js&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Đăng nhập (token) · gõ câu hỏi HOẶC chọn câu mẫu BIRD dev (student_club, id 1312–1469) · chọn chế độ live/replay · chọn model hoặc lượt benchmark · tick &quot;Dùng evidence&quot; · tick &quot;Áp dụng từ điển nghiệp vụ&quot; · (tuỳ chọn) gõ evidence&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Bấm &lt;b&gt;Hỏi&lt;/b&gt; → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;fetch('POST /api/ask', {headers: {Authorization: token}, body: AskIn})&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;AskIn = {question, mode: &quot;live&quot;|&quot;replay&quot;, model_id, run_id, dev_question_id, use_evidence, evidence, use_glossary}&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="820" height="238" as="geometry"/></mxCell><mxCell id="c4" value='&lt;div style="font-size:14px"&gt;&lt;b&gt;Bước 2. current_user(authorization) → main.ask(body, user, conn)&lt;/b&gt;&lt;/div&gt;&lt;font color="#666666"&gt;&lt;i&gt;app/backend/main.py (FastAPI)&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#1a7f37"&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Header &lt;font face="Consolas" color="#1f4e79"&gt;Authorization&lt;/font&gt;, &lt;font face="Consolas" color="#1f4e79"&gt;body: AskIn&lt;/font&gt;, &lt;font face="Consolas" color="#1f4e79"&gt;conn = db()&lt;/font&gt; (kết nối app.sqlite)&lt;hr&gt;&lt;b&gt;&lt;font color="#9a6700"&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;current_user&lt;/font&gt;: tra token → &lt;font face="Consolas" color="#1f4e79"&gt;user = {id, username, role ∈ member|board|admin}&lt;/font&gt; (sai → 401)&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;main.ask&lt;/font&gt;: không có question lẫn dev_question_id → 422; gọi &lt;font face="Consolas" color="#1f4e79"&gt;service.ask(conn, user, question, mode, model_id, run_id, dev_question_id, use_evidence, evidence, use_glossary)&lt;/font&gt;; &lt;font face="Consolas" color="#1f4e79"&gt;ValueError&lt;/font&gt; → 422&lt;hr&gt;&lt;b&gt;&lt;font color="#cf222e"&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;dict &lt;font face="Consolas" color="#1f4e79"&gt;out&lt;/font&gt; từ service.ask → JSON' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="398" width="820" height="254" as="geometry"/></mxCell><mxCell id="c5" value="HTTP POST /api/ask" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 3. service.ask — khởi tạo &amp; đọc câu mẫu&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;app/backend/service.py&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;dev_question_id&lt;/font&gt; (có thể None)&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;started = time.monotonic()&lt;/font&gt;; tạo &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;out = {status, sql, columns, rows, answer, error, is_correct, gold_sql, evidence_used, glossary_used, …}&lt;/font&gt;&lt;br&gt;Nếu có câu dev: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;SELECT * FROM dev_question WHERE id = ?&lt;/font&gt; → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;dev_q&lt;/font&gt; {question, evidence, gold_sql}; &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;question = dev_q['question']&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;question&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;dev_q&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="702" width="820" height="271" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="mode ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="1023" width="300" height="90" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value='&lt;div style="font-size:14px"&gt;&lt;b&gt;Bước 4a. PHÁT LẠI (replay)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#1a7f37"&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;run_id, dev_question_id&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#9a6700"&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;SELECT b.predicted_sql, r.model_id FROM benchmark_item b JOIN benchmark_run r … WHERE run_id=? AND question_id=?&lt;/font&gt;&lt;br&gt;Không gọi LLM — lấy đúng SQL đã sinh ở luồng benchmark ② (nạp qua per_db_ex.py → POST /api/benchmark/import)&lt;hr&gt;&lt;b&gt;&lt;font color="#cf222e"&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;sql&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1153" width="260" height="320" as="geometry"/></mxCell><mxCell id="c11" value="replay" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value='&lt;div style="font-size:14px"&gt;&lt;b&gt;Bước 4b.1 Chọn model&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#1a7f37"&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;model_id&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#9a6700"&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;SELECT * FROM model_config WHERE id=? AND is_active=1&lt;/font&gt; (không có → ValueError)&lt;hr&gt;&lt;b&gt;&lt;font color="#cf222e"&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;model = {provider, model_tag, base_url, api_key_env}&lt;/font&gt; VD gpt-3.5-turbo / qwen2.5-coder:7b @ http://localhost:11434/v1' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="1153" width="520" height="254" as="geometry"/></mxCell><mxCell id="c13" value="live" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 4b.2 Ghép evidence&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;match_glossary + normalize_pseudo_sql&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;dev_q.evidence&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;use_evidence&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;evidence&lt;/font&gt; tự nhập, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;use_glossary&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;question&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;parts = []&lt;/font&gt;&lt;br&gt;• có câu dev &amp;amp; use_evidence → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;parts.append(dev_q['evidence'])&lt;/font&gt;&lt;br&gt;• else có evidence tự nhập → thêm vào&lt;br&gt;• use_glossary → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;match_glossary(conn, question)&lt;/font&gt;: lấy thuật ngữ đang bật có xuất hiện trong câu hỏi (lowercase) → thêm &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;&quot;&amp;lt;term&amp;gt; refers to &amp;lt;definition&amp;gt;&quot;&lt;/font&gt;&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;knowledge = normalize_pseudo_sql('; '.join(parts))&lt;/font&gt; hoặc None&lt;br&gt;(tương đương WITH / WITHOUT knowledge của benchmark)&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;knowledge&lt;/font&gt; → lưu &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;out['evidence_used']&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;out['glossary_used']&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="1447" width="520" height="320" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 4b.3 Dựng prompt — prompt.build_prompt(question, knowledge, role)&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;app/backend/prompt.py&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;question&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;knowledge&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;user['role']&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;schema_prompt(role)&lt;/font&gt;: CREATE TABLE từ student_club.sqlite, &lt;b&gt;lọc bảng/cột theo vai trò&lt;/b&gt; (member: bỏ budget, expense, income, member.email, member.phone); cache theo role&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;comment_prompt(question, knowledge)&lt;/font&gt;: giống &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;generate_comment_prompt&lt;/font&gt; ở ②&lt;br&gt;Ghép: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;schema + '\n\n' + comment + '\nRespond with the final SQLite query only, inside a ```sql code block. …'&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;prompt&lt;/font&gt; (giống prompt của ollama_request.py)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="1807" width="520" height="304" as="geometry"/></mxCell><mxCell id="c17" value="knowledge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 4b.4 Gọi LLM + tách SQL — llm.generate_sql(model, prompt, timeout_s=120)&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;app/backend/llm.py&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;model&lt;/font&gt; (dict), &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;prompt&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;llm.complete(model, prompt, max_tokens=512)&lt;/font&gt;: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;OpenAI(api_key=env[api_key_env], base_url=model.base_url)&lt;/font&gt; → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;chat.completions.create(model=model_tag, messages=[{'role':'user','content':prompt}], temperature=0, max_tokens=512)&lt;/font&gt; (OpenAI / Groq / Ollama đều tương thích API OpenAI)&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;extract_sql(raw)&lt;/font&gt; — import từ &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;ollama_request.py&lt;/font&gt; (cùng hàm với benchmark)&lt;br&gt;Lỗi → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;LLMError&lt;/font&gt; → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;QueryRejected('FAILED_GENERATION')&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;sql&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="2151" width="520" height="320" as="geometry"/></mxCell><mxCell id="c19" value="prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c16" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 5. guard.check_select(sql) — lớp chặn 1 (trên chuỗi)&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;app/backend/guard.py&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;sql&lt;/font&gt; (từ live hoặc replay); &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;out['sql'] = sql&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;sqlparse.split(sql)&lt;/font&gt;: rỗng → FAILED_GENERATION; &amp;gt; 1 câu → REJECTED_UNSAFE&lt;br&gt;Từ khoá đầu ∈ {INSERT, UPDATE, DELETE, DROP, ALTER, CREATE, PRAGMA, ATTACH…} → REJECTED_UNSAFE&lt;br&gt;Không bắt đầu bằng SELECT / WITH → FAILED_GENERATION&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;sql&lt;/font&gt; đã bỏ ; cuối" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="2531" width="820" height="254" as="geometry"/></mxCell><mxCell id="c21" value="sql" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="sql" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 6. guard.execute(sql, role, timeout_s=10) — lớp chặn 2 (trong SQLite)&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;app/backend/guard.py&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;sql&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;role&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;connect_readonly()&lt;/font&gt;: mở student_club.sqlite với &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;?mode=ro&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;conn.set_authorizer(_authorizer(role, denied))&lt;/font&gt;: chỉ cho SELECT/READ/FUNCTION/RECURSIVE; đọc bảng/cột bị cấm theo role → từ chối&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;conn.set_progress_handler(…)&lt;/font&gt;: quá 10 s → ngắt&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;cursor.execute(sql); rows = fetchall()&lt;/font&gt;; &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;columns = [d[0] for d in cursor.description]&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;(columns, rows)&lt;/font&gt; → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;out.status = 'EXECUTED'&lt;/font&gt;, rows cắt tối đa &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;MAX_ROWS = 1000&lt;/font&gt; (truncated)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="2825" width="820" height="287" as="geometry"/></mxCell><mxCell id="c24" value="sql an toàn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c20" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value='&lt;div style="font-size:14px"&gt;&lt;b&gt;Bước 7. answer.make_answer(question, columns, rows, model)&lt;/b&gt;&lt;/div&gt;&lt;font color="#666666"&gt;&lt;i&gt;app/backend/answer.py&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#1a7f37"&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;question&lt;/font&gt;, &lt;font face="Consolas" color="#1f4e79"&gt;columns&lt;/font&gt;, &lt;font face="Consolas" color="#1f4e79"&gt;rows&lt;/font&gt;, &lt;font face="Consolas" color="#1f4e79"&gt;model&lt;/font&gt; (None nếu replay)&lt;hr&gt;&lt;b&gt;&lt;font color="#9a6700"&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Live: &lt;font face="Consolas" color="#1f4e79"&gt;llm_answer&lt;/font&gt; gửi câu hỏi + tối đa 30 dòng đầu cho LLM, yêu cầu trả lời 1–3 câu tiếng Việt chỉ dựa trên dữ liệu&lt;br&gt;Replay / LLM lỗi: &lt;font face="Consolas" color="#1f4e79"&gt;template_answer(columns, rows)&lt;/font&gt; → "Kết quả: 12." / "Có 5 kết quả: …"&lt;hr&gt;&lt;b&gt;&lt;font color="#cf222e"&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas" color="#1f4e79"&gt;(answer, answer_source ∈ {llm, template})&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="3152" width="820" height="238" as="geometry"/></mxCell><mxCell id="c26" value="columns, rows" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c23" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 8. So với đáp án gold (chỉ khi là câu dev — cả live và replay)&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;service.py&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;dev_q['gold_sql']&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;rows&lt;/font&gt; của SQL sinh ra&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;gold_cols, gold_rows = guard.execute(gold_sql, 'admin', timeout_s=30)&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;same_result(rows, gold_rows) = set(rows) == set(gold_rows)&lt;/font&gt; — &lt;b&gt;cùng tiêu chí với execute_sql của evaluation.py&lt;/b&gt; (EX)&lt;br&gt;Gold SQL không chạy được → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;is_correct = None&lt;/font&gt;. (Nếu SQL sinh ra bị chặn/lỗi ở bước 5/6: REJECTED_PERMISSION → None, lỗi khác → 0)&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;out['gold_sql']&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;out['is_correct'] ∈ {1, 0, None}&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="3430" width="820" height="271" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c25" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 9. Ghi query_log (finally — kể cả khi lỗi/bị chặn)&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;service.py → app.sqlite&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;toàn bộ &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;out&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;user&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;latency_ms = (monotonic() - started)·1000&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;INSERT INTO query_log (user_id, question, mode, model_id, run_id, evidence_used, glossary_used, sql, answer, status, error, latency_ms, row_count, is_correct, …)&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;out['log_id']&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;out['latency_ms']&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="3741" width="820" height="238" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c27" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value='&lt;div style="font-size:14px"&gt;&lt;b&gt;Bước 10. Trả JSON → app.js renderResult(out)&lt;/b&gt;&lt;/div&gt;&lt;font color="#666666"&gt;&lt;i&gt;app/frontend/app.js&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#1a7f37"&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;JSON: &lt;font face="Consolas" color="#1f4e79"&gt;status, sql, columns, rows, row_count, truncated, answer, answer_source, evidence_used, glossary_used, gold_sql, is_correct, error, latency_ms, log_id&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color="#9a6700"&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Hiển thị: badge trạng thái · khối SQL · bảng kết quả (≤1000 dòng) · câu trả lời tiếng Việt (nguồn llm/template) · evidence đã đưa vào prompt · thuật ngữ đã áp dụng · gold SQL + nhãn &lt;b&gt;Đúng/Sai&lt;/b&gt; · thời gian xử lý · nút feedback / xuất CSV (board, admin)&lt;hr&gt;&lt;b&gt;&lt;font color="#cf222e"&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Màn hình kết quả cho người dùng' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="4019" width="820" height="271" as="geometry"/></mxCell><mxCell id="c32" value="out (JSON)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c29" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value='&lt;b&gt;TRẠNG THÁI LỖI (QueryRejected → out.status)&lt;/b&gt;&lt;hr&gt;&lt;table border="1" cellpadding="4" style="border-collapse:collapse;font-size:11px"&gt;&lt;tr&gt;&lt;th&gt;status&lt;/th&gt;&lt;th&gt;Phát sinh ở&lt;/th&gt;&lt;th&gt;Khi nào&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;FAILED_GENERATION&lt;/td&gt;&lt;td&gt;bước 4b.4, 5&lt;/td&gt;&lt;td&gt;LLM lỗi / SQL rỗng / không phải SELECT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;REJECTED_UNSAFE&lt;/td&gt;&lt;td&gt;bước 5, 6&lt;/td&gt;&lt;td&gt;nhiều câu, lệnh ghi/xoá/PRAGMA…&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;REJECTED_PERMISSION&lt;/td&gt;&lt;td&gt;bước 6&lt;/td&gt;&lt;td&gt;đọc bảng/cột role không được xem&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;TIMEOUT&lt;/td&gt;&lt;td&gt;bước 6&lt;/td&gt;&lt;td&gt;chạy &amp;gt; 10 s&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;EXEC_ERROR&lt;/td&gt;&lt;td&gt;bước 6&lt;/td&gt;&lt;td&gt;sai tên cột, sai cú pháp…&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;EXECUTED&lt;/td&gt;&lt;td&gt;bước 6&lt;/td&gt;&lt;td&gt;thành công&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;Có lỗi → bỏ qua bước 7, 8 (is_correct = 0 với câu dev, trừ REJECTED_PERMISSION = None), vẫn ghi log (bước 9) và trả về UI.' style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="110" width="560" height="238" as="geometry"/></mxCell><mxCell id="c34" value="lỗi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;fontColor=#555555;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="c20" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="lỗi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;fontColor=#555555;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="c23" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value='&lt;b&gt;SO SÁNH VỚI LUỒNG BENCHMARK ②&lt;/b&gt;&lt;hr&gt;&lt;table border="1" cellpadding="4" style="border-collapse:collapse;font-size:11px"&gt;&lt;tr&gt;&lt;th&gt;&lt;/th&gt;&lt;th&gt;Benchmark ②&lt;/th&gt;&lt;th&gt;Text-to-SQL ⑤&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Đầu vào&lt;/td&gt;&lt;td&gt;1.534 câu dev.json (batch)&lt;/td&gt;&lt;td&gt;1 câu người dùng / câu dev&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Knowledge&lt;/td&gt;&lt;td&gt;evidence hoặc None (--no_knowledge)&lt;/td&gt;&lt;td&gt;evidence + từ điển nghiệp vụ, chuẩn hoá&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Schema&lt;/td&gt;&lt;td&gt;toàn bộ CREATE TABLE&lt;/td&gt;&lt;td&gt;lọc theo vai trò người dùng&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Gọi LLM&lt;/td&gt;&lt;td&gt;call_openai / call_ollama&lt;/td&gt;&lt;td&gt;llm.complete (OpenAI-compatible)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Tách SQL&lt;/td&gt;&lt;td colspan="2"&gt;extract_sql (dùng chung)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Sau khi có SQL&lt;/td&gt;&lt;td&gt;ghép + ghi predict_dev.json&lt;/td&gt;&lt;td&gt;check_select → execute read-only → answer&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;So đáp án&lt;/td&gt;&lt;td&gt;evaluation.py (EX), evaluation_ves.py (VES) cho cả tập&lt;/td&gt;&lt;td&gt;same_result từng câu (cùng tiêu chí EX)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Đầu ra&lt;/td&gt;&lt;td&gt;điểm EX / VES&lt;/td&gt;&lt;td&gt;bảng kết quả + câu trả lời trên UI + query_log&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="560" width="560" height="287" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;VÍ DỤ: câu 1379, live, vai trò thủ quỹ (board), tick evidence&lt;/b&gt;&lt;hr&gt;evidence_used = &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;meeting events refers to type = 'Meeting'; held in 2020 refers to CAST(STRFTIME('%Y', event_date) AS INTEGER) = 2020&lt;/font&gt;&lt;br&gt;sql = &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;SELECT COUNT(*) FROM event WHERE type = 'Meeting' AND …&lt;/font&gt;&lt;br&gt;status = EXECUTED, columns = [COUNT(*)], rows = [[n]]&lt;br&gt;answer = &quot;Năm 2020 câu lạc bộ đã tổ chức n buổi họp.&quot;&lt;br&gt;gold chạy ra [[n]] → is_correct = 1 → UI hiện nhãn Đúng" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="1080" width="560" height="172" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>