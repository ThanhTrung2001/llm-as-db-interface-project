        <mxCell id="pOut" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;prompt&lt;/b&gt; = A + &quot;\n\n&quot; + B + C → gửi &lt;b&gt;1 tin nhắn&lt;/b&gt; &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;{&quot;role&quot;: &quot;user&quot;, &quot;content&quot;: prompt}&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;temperature = 0&lt;/font&gt; → bước 5 &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;call_openai / call_ollama&lt;/font&gt;" vertex="1">
