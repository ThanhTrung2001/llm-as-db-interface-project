        <mxCell id="c37" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" value="&lt;b&gt;So với gold&lt;/b&gt; (nếu là câu dev)&lt;br&gt;chạy gold SQL quyền admin → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;same_result = set(rows)==set(gold_rows)&lt;/font&gt; → is_correct" vertex="1">
          <mxGeometry height="130" width="220" x="1630" y="1240" as="geometry" />
