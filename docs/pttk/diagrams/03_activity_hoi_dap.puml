@startuml activity_hoi_dap
!include _style.iuml
title Biểu đồ hoạt động — UC02 Hỏi đáp bằng ngôn ngữ tự nhiên

|Người dùng|
start
:Chọn model (mặc định: model đánh dấu mặc định);
if (Dùng câu hỏi mẫu BIRD?) then (có)
  :Mở "BIRD sample questions",
tìm / lọc theo độ khó, chọn một câu;
  |Hệ thống|
  :Điền câu hỏi và evidence của câu mẫu
vào ô "External knowledge";
  |Người dùng|
endif
:Nhập / sửa câu hỏi (3–500 ký tự)
và tri thức ngoài (tuỳ chọn, ≤ 2000 ký tự);
:Bấm "Ask";
|Hệ thống|
if (Model tồn tại và đang bật?) then (không)
  :Báo lỗi 422 (không tạo log);
  stop
endif
if (Có tri thức ngoài?) then (có)
  :Đưa tri thức ngoài vào tri thức (giữ nguyên văn);
endif
if (Câu hỏi chứa thuật ngữ đang bật?) then (có)
  :Nối "<term> refers to <definition>"\nđã chuẩn hoá hàm giả (normalize_pseudo_sql);
endif
if (Tri thức rỗng?) then (có)
  :Prompt không có dòng External Knowledge\n(như prompt "không evidence" của BIRD);
else (không)
  :Thêm dòng "-- External Knowledge: …";
endif
:Dựng prompt theo khuôn BIRD\nschema chỉ gồm bảng/cột vai trò được xem (BR03);
|Dịch vụ LLM|
:Sinh văn bản chứa SQL;
|Hệ thống|
:Tách SQL (extract_sql);
if (Gọi model lỗi / không phải SQL?) then (có)
  :status = FAILED_GENERATION;
elseif (Nhiều câu lệnh / lệnh ghi?) then (có)
  :status = REJECTED_UNSAFE;
else (đúng một câu SELECT, BR01)
  |CSDL club.sqlite|
  :Thực thi mode=ro + authorizer theo vai trò\n+ timeout 10 giây (BR02, BR03);
  |Hệ thống|
  if (Kết quả?) then (đọc bảng/cột bị cấm)
    :status = REJECTED_PERMISSION;
  elseif () then (quá giờ / lỗi SQLite)
    :status = TIMEOUT / EXEC_ERROR;
  else (thành công)
    :status = EXECUTED;\nCắt còn 1000 dòng (BR02);
    |Dịch vụ LLM|
    :Diễn giải câu hỏi + tối đa 30 dòng\nthành 1–3 câu trả lời tiếng Anh;
    |Hệ thống|
    if (Model lỗi khi diễn giải?) then (có)
      :Dựng câu trả lời theo mẫu;
    endif
  endif
endif
:Ghi query_log (sample_id, evidence,\nthuật ngữ, trạng thái cuối) (BR04);
|Người dùng|
:Xem câu trả lời, tri thức đã thêm, bảng dữ liệu,\n"External knowledge sent to the model", SQL;
if (Đánh giá / xuất CSV / hỏi lại?) then (có)
  :Bấm Correct / Wrong (UC04),\nCSV (UC05) hoặc Ask again;
endif
stop
@enduml
