  <diagram id="p0" name="0. Tổng quan">
    <mxGraphModel dx="1983" dy="1139" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2300" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;whiteSpace=wrap;" value="TỔNG QUAN: Benchmark BIRD (Text-to-SQL) và ứng dụng ClubQuery" vertex="1">
          <mxGeometry height="40" width="1800" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" value="Màu: &lt;b&gt;xanh dương&lt;/b&gt; = hàm sinh SQL · &lt;b&gt;tím&lt;/b&gt; = hàm chấm điểm · &lt;b&gt;cam&lt;/b&gt; = gọi LLM · &lt;b&gt;đỏ&lt;/b&gt; = kiểm tra an toàn · &lt;b&gt;xanh lá&lt;/b&gt; = ứng dụng web · &lt;b&gt;vàng&lt;/b&gt; = dữ liệu/file. Chi tiết từng hàm (input → xử lý → output) xem các trang 1 → 3." vertex="1">
          <mxGeometry height="30" width="1800" x="40" y="60" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;① CHUẨN BỊ DỮ LIỆU&lt;/b&gt;&lt;/div&gt;&lt;i&gt;(trang 1)&lt;/i&gt;&lt;hr&gt;• Tải BIRD dev → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;bird/data/&lt;/font&gt;&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;dev.json&lt;/font&gt;: 1.534 câu {question_id, db_id, question, evidence, SQL, difficulty}&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;dev_gold.sql&lt;/font&gt;: 1.534 dòng &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;SQL\tdb_id&lt;/font&gt;&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;dev_databases/&lt;/font&gt;: 11 CSDL SQLite&lt;br&gt;• Phân tích: độ khó 925/464/145; 11 db_id; 1.386 câu có evidence, 148 câu rỗng; phân loại SQL 6 mức; 192 evidence có hàm giả" vertex="1">
          <mxGeometry height="221" width="330" x="40" y="130" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" value="Cấu hình&lt;br&gt;evidence?" vertex="1">
          <mxGeometry height="120" width="200" x="430" y="200" as="geometry" />
        </mxCell>
        <mxCell id="c5" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;WITH knowledge&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;knowledge_list[i] = evidence&lt;/font&gt;&lt;br&gt;Prompt có dòng &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;-- External Knowledge: …&lt;/font&gt;&lt;br&gt;→ thư mục &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;*_output/&lt;/font&gt;" vertex="1">
          <mxGeometry height="122" width="270" x="690" y="130" as="geometry" />
        </mxCell>
        <mxCell id="c6" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;WITHOUT knowledge&lt;/b&gt;&lt;br&gt;cờ &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--no_knowledge&lt;/font&gt; → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;knowledge_list = [None]*n&lt;/font&gt;&lt;br&gt;Prompt không có evidence&lt;br&gt;→ thư mục &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;*_0_output/&lt;/font&gt;" vertex="1">
          <mxGeometry height="122" width="270" x="690" y="300" as="geometry" />
        </mxCell>
        <mxCell id="c7" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;② SINH SQL (benchmark)&lt;/b&gt;&lt;/div&gt;&lt;i&gt;(trang 2a)&lt;/i&gt; &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;openai_request.py&lt;/font&gt; / &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;ollama_request(2).py&lt;/font&gt;&lt;hr&gt;Lặp từng câu i = 0 … 1533:&lt;br&gt;1. &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;decouple_question_schema&lt;/font&gt; → question, db_path, knowledge&lt;br&gt;&lt;b&gt;2–4. DỰNG PROMPT&lt;/b&gt; = A + B + C &lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;▼ xem khung ②ᵃ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;5. &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;call_openai / call_ollama&lt;/font&gt; (temperature = 0) → raw text&lt;br&gt;6. &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;extract_sql&lt;/font&gt; → bỏ ```sql / &amp;lt;think&amp;gt;, cắt tại ; → SQL&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(lỗi → SQL = &quot;SELECT&quot;, chạy tiếp câu sau)&lt;br&gt;7. ghép &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;SQL + &quot;\t----- bird -----\t&quot; + db_id&lt;/font&gt;&lt;br&gt;8. &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;generate_sql_file&lt;/font&gt; → predict_dev.json (ghi tạm mỗi 50 câu)" vertex="1">
          <mxGeometry height="250" width="360" x="1020" y="130" as="geometry" />
        </mxCell>
        <mxCell id="c8" parent="1" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;size=0.08;" value="&lt;b&gt;predict_dev.json&lt;/b&gt;&lt;br&gt;{&quot;0&quot;: &quot;SELECT …\t----- bird -----\tcalifornia_schools&quot;, …, &quot;1533&quot;: …}&lt;br&gt;(đủ 1.534 khoá)" vertex="1">
          <mxGeometry height="120" width="230" x="1440" y="190" as="geometry" />
        </mxCell>
        <mxCell id="c9" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;③ CHẤM EX&lt;/b&gt; — Execution Accuracy&lt;/div&gt;&lt;i&gt;(trang 2b)&lt;/i&gt; &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;evaluation.py&lt;/font&gt;&lt;hr&gt;Không so chữ SQL — &lt;b&gt;chạy&lt;/b&gt; predicted SQL và gold SQL trên cùng CSDL;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;set(pred_rows) == set(gold_rows)&lt;/font&gt; → 1, khác → 0&lt;br&gt;SQL lỗi / sai cột / quá 30 s → 0&lt;br&gt;&lt;br&gt;&lt;b&gt;Ví dụ 1379:&lt;/b&gt;&lt;br&gt;pred: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;... STRFTIME(&#39;%Y&#39;, event_date) = &#39;2020&#39;&lt;/font&gt; → [(n,)]&lt;br&gt;gold: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;... SUBSTR(event_date, 1, 4) = &#39;2020&#39;&lt;/font&gt; → [(n,)]&lt;br&gt;→ viết khác, cùng kết quả → &lt;b&gt;1&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;EX = 100 × Σ đúng / N&lt;/b&gt; (simple / moderate / challenging / total)" vertex="1">
          <mxGeometry height="320" width="330" x="1730" y="110" as="geometry" />
        </mxCell>
        <mxCell id="c10" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;③ CHẤM VES&lt;/b&gt; — Valid Efficiency Score&lt;/div&gt;&lt;i&gt;(trang 2c)&lt;/i&gt; &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;evaluation_ves.py&lt;/font&gt;&lt;hr&gt;1. Chạy pred &amp;amp; gold 1 lần, so set như EX. &lt;b&gt;Sai / lỗi / timeout → R = 0&lt;/b&gt;, không đo&lt;br&gt;2. Đúng → lặp &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;iterate_num = 5&lt;/font&gt; lần: đo t_pred, t_gold → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;t_gold / t_pred&lt;/font&gt;&lt;br&gt;3. &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;clean_abnormal&lt;/font&gt;: bỏ lần đo ngoài mean ± 3σ → trung bình = &lt;b&gt;R&lt;/b&gt;&lt;br&gt;4. Điểm câu = &lt;b&gt;√R × 100&lt;/b&gt; &amp;nbsp;(R=1 → 100 · R=4 → 200 · R=0,25 → 50)&lt;br&gt;&lt;b&gt;VES = Σ điểm / N&lt;/b&gt; → có thể &amp;gt; EX nếu SQL model chạy nhanh hơn gold" vertex="1">
          <mxGeometry height="250" width="330" x="1730" y="450" as="geometry" />
        </mxCell>
        <mxCell id="c11" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;④ BẢNG KẾT QUẢ&lt;/b&gt;&lt;/div&gt;&lt;i&gt;(trang 2d)&lt;/i&gt;&lt;hr&gt;Lặp cho mỗi model ∈ {GPT-3.5-Turbo (paper), DeepSeek-Coder-V2, Qwen2.5-Coder, Gemma3, …} × {with, without}:&lt;br&gt;→ 2 file predict_dev.json → 4 con số: &lt;b&gt;EX w/ KG · EX w/o KG · VES w/ KG · VES w/o KG&lt;/b&gt;&lt;br&gt;Chạy trên &lt;b&gt;Kaggle (GPU T4)&lt;/b&gt;: sinh SQL ≈ &lt;b&gt;__ giờ / lượt&lt;/b&gt; · chấm EX + VES ≈ &lt;b&gt;__ giờ&lt;/b&gt;&lt;br&gt;Ví dụ GPT-3.5-Turbo (w/o → w/ KG): EX &lt;b&gt;31,23 → 47,78&lt;/b&gt; · VES &lt;b&gt;33,88 → 53,88&lt;/b&gt;" vertex="1">
          <mxGeometry height="170" width="620" x="1440" y="730" as="geometry" />
        </mxCell>
