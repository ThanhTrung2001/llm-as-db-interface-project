@startuml usecase_hoi_dap
!include _style.iuml
left to right direction
title Phân rã UC02 — Hỏi đáp bằng ngôn ngữ tự nhiên

actor "Người dùng\n(mọi vai trò)" as ND
actor "Dịch vụ LLM" as LLM <<hệ thống ngoài>>

rectangle "ClubQuery" {
  usecase "UC02 Hỏi đáp bằng\nngôn ngữ tự nhiên" as UC02
  usecase "UC02a Sinh SQL" as GEN
  usecase "UC02b Kiểm tra an toàn\n(một câu SELECT)" as CHECK
  usecase "UC02c Thực thi chỉ đọc\ntheo quyền vai trò" as EXEC
  usecase "UC02d Áp dụng thuật ngữ\ntừ điển" as GLOSS
  usecase "UC02e Ghi nhật ký truy vấn" as LOG
  usecase "UC02f Diễn giải kết quả\nthành câu trả lời" as ANS
  usecase "UC02g Nhập tri thức ngoài\n(External knowledge)" as EVID
  usecase "UC02h Chọn câu hỏi mẫu BIRD\n(158 câu, kèm evidence)" as SAMPLE
  usecase "UC04 Đánh giá câu trả lời" as UC04
  usecase "UC05 Xuất kết quả CSV" as UC05
}

ND --> UC02
UC02 ..> GEN : <<include>>
UC02 ..> CHECK : <<include>>
UC02 ..> EXEC : <<include>>
UC02 ..> LOG : <<include>>
GLOSS ..> GEN : <<extend>>\n[câu hỏi chứa thuật ngữ đang bật]
EVID ..> UC02 : <<extend>>\n[người dùng nhập gợi ý]
SAMPLE ..> UC02 : <<extend>>\n[người dùng chọn câu mẫu]
SAMPLE ..> EVID : <<include>>\n(điền evidence)
ANS ..> UC02 : <<extend>>\n[thực thi thành công]
UC04 ..> UC02 : <<extend>>
UC05 ..> UC02 : <<extend>>\n[trạng thái EXECUTED]
GEN --> LLM
ANS --> LLM
@enduml
