        <mxCell id="c1" value="① CHUẨN BỊ DỮ LIỆU — tải và phân tích tập BIRD dev" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
