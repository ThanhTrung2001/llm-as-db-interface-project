@startuml erd
!include _style.iuml
title ERD — CSDL nghiệp vụ club.sqlite và CSDL ứng dụng app.sqlite
hide circle
set separator none
skinparam linetype ortho

package "club.sqlite — dữ liệu nghiệp vụ CLB (chép từ student_club.sqlite của BIRD)" #f3f7fd {
  entity member {
    * member_id : TEXT <<PK>>
    --
    first_name, last_name : TEXT
    email : TEXT <<pii>>
    position : TEXT
    t_shirt_size : TEXT
    phone : TEXT <<pii>>
    zip : INTEGER <<FK>>
    link_to_major : TEXT <<FK>>
  }
  entity major {
    * major_id : TEXT <<PK>>
    --
    major_name, department, college : TEXT
  }
  entity zip_code {
    * zip_code : INTEGER <<PK>>
    --
    type, city, county, state, short_state : TEXT
  }
  entity event {
    * event_id : TEXT <<PK>>
    --
    event_name, event_date, type : TEXT
    notes, location : TEXT
    status : Planning | Open | Closed
  }
  entity attendance {
    * link_to_event : TEXT <<PK, FK>>
    * link_to_member : TEXT <<PK, FK>>
  }
  entity budget <<finance>> {
    * budget_id : TEXT <<PK>>
    --
    category : TEXT
    amount : INTEGER
    spent, remaining : REAL (suy ra, BR06)
    event_status : TEXT (bản sao event.status)
    link_to_event : TEXT <<FK>>
  }
  entity expense <<finance>> {
    * expense_id : TEXT <<PK>>
    --
    expense_description, expense_date : TEXT
    cost : REAL
    approved : pending | true | false
    link_to_member : TEXT <<FK>>
    link_to_budget : TEXT <<FK>>
  }
  entity income <<finance>> {
    * income_id : TEXT <<PK>>
    --
    date_received : TEXT
    amount : INTEGER
    source, notes : TEXT
    link_to_member : TEXT <<FK>>
  }
}

major ||--o{ member
zip_code |o--o{ member
member ||--o{ attendance
event ||--o{ attendance
event ||--o{ budget
budget ||--o{ expense
member |o--o{ expense
member |o--o{ income

package "app.sqlite — dữ liệu ứng dụng" #fdf8ee {
  entity user_account {
    * id : INTEGER <<PK>>
    --
    username : TEXT <<UNIQUE>>
    full_name, password_hash : TEXT
    role : president | treasurer | event | admin
    is_active : INTEGER
  }
  entity model_config {
    * id : INTEGER <<PK>>
    --
    name : TEXT <<UNIQUE>>
    provider : groq | openrouter | ollama
    model_tag, base_url, api_key_env : TEXT
    is_active, is_default : INTEGER
  }
  entity glossary_term {
    * id : INTEGER <<PK>>
    --
    term : TEXT <<UNIQUE NOCASE>>
    definition : TEXT
    is_active : INTEGER
    updated_by : INTEGER <<FK>>
    updated_at : TEXT
  }
  entity query_log {
    * id : INTEGER <<PK>>
    --
    user_id : INTEGER <<FK>>
    model_id : INTEGER <<FK>>
    sample_id : INTEGER <<FK>>
    question, evidence, glossary_used : TEXT
    generated_sql, answer, status, error : TEXT
    latency_ms, row_count : INTEGER
    created_at : TEXT
  }
  entity sample_question {
    * id : INTEGER <<PK>> (= question_id BIRD)
    --
    question, evidence : TEXT
    difficulty : simple | moderate | challenging
  }
  entity feedback {
    * id : INTEGER <<PK>>
    --
    query_log_id, user_id : INTEGER <<FK>>
    rating : -1 | 1
    comment, created_at : TEXT
  }
  entity expense_review {
    * expense_id : TEXT <<PK>> (= club.expense)
    --
    proposed_by : INTEGER <<FK>>
    proposed_at : TEXT
    reviewed_by : INTEGER <<FK>>
    reviewed_at, note : TEXT
  }
  entity audit_log {
    * id : INTEGER <<PK>>
    --
    user_id : INTEGER <<FK>>
    action : CREATE | UPDATE | DELETE | APPROVE | REJECT
    entity, entity_id, summary : TEXT
    detail : TEXT (JSON trước/sau)
    created_at : TEXT
  }
}

user_account ||--o{ query_log
user_account ||--o{ feedback
user_account |o--o{ glossary_term
model_config |o--o{ query_log
query_log ||--o{ feedback
sample_question |o--o{ query_log
user_account ||--o{ expense_review
user_account ||--o{ audit_log
expense ||..o| expense_review : liên kết logic\n(khác CSDL)
@enduml
