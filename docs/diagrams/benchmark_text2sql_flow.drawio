        </mxCell>
        <mxCell id="c2" value="Mục tiêu: có đủ câu hỏi + evidence + CSDL để sinh SQL, và đáp án gold + độ khó để chấm. Không sửa dev.json / CSDL (giữ nguyên để so sánh công bằng với paper)." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Tải BIRD dev set&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;bird-bench.github.io → dev.zip (bản dev_20240627)&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Link tải bộ dev của BIRD&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Giải nén vào &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;src/DAMO-ConvAI/bird/data/&lt;/font&gt;; giải nén tiếp &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;dev_databases.zip&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Thư mục &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;bird/data/&lt;/font&gt; gồm 4 thành phần (bên phải)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="400" height="238" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;dev.json&lt;/b&gt; — 1.534 phần tử&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;{&lt;br&gt;&amp;nbsp;&quot;question_id&quot;: 1379,&lt;br&gt;&amp;nbsp;&quot;db_id&quot;: &quot;student_club&quot;,&lt;br&gt;&amp;nbsp;&quot;question&quot;: &quot;How many meeting events were held in 2020?&quot;,&lt;br&gt;&amp;nbsp;&quot;evidence&quot;: &quot;meeting events refers to type = &#39;Meeting&#39;; held in 2020 refers to YEAR(event_date) = 2020&quot;,&lt;br&gt;&amp;nbsp;&quot;SQL&quot;: &quot;SELECT COUNT(event_id) FROM event WHERE …&quot;,&lt;br&gt;&amp;nbsp;&quot;difficulty&quot;: &quot;simple&quot;&lt;br&gt;}&lt;/font&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;size=0.08;" vertex="1" parent="1">
          <mxGeometry x="520" y="110" width="380" height="221" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;dev_gold.sql&lt;/b&gt; — 1.534 dòng&lt;br&gt;Mỗi dòng: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;&amp;lt;gold SQL&amp;gt;\t&amp;lt;db_id&amp;gt;&lt;/font&gt;&lt;br&gt;Dòng i ↔ dev.json[i] ↔ khoá &quot;i&quot; trong predict_dev.json&lt;br&gt;(nằm ở &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;bird/llm/data/dev_gold.sql&lt;/font&gt;)" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;size=0.08;" vertex="1" parent="1">
          <mxGeometry x="960" y="110" width="360" height="122" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;dev_databases/&lt;/b&gt; — 11 CSDL SQLite&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;&amp;lt;db_root&amp;gt;/&amp;lt;db_id&amp;gt;/&amp;lt;db_id&amp;gt;.sqlite&lt;/font&gt;&lt;br&gt;+ &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;database_description/*.csv&lt;/font&gt; (mô tả cột – prompt KHÔNG dùng)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;align=center;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
