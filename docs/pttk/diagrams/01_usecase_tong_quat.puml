@startuml usecase_tong_quat
!include _style.iuml
left to right direction
title Biểu đồ use case tổng quát — ClubQuery

actor "Người dùng\n(mọi vai trò)" as ND
actor "Chủ nhiệm" as CN
actor "Thủ quỹ" as TQ
actor "Ban sự kiện" as SK
actor "Quản trị hệ thống" as QT
actor "Dịch vụ LLM\n(Ollama, Groq)" as LLM <<hệ thống ngoài>>

rectangle "ClubQuery" {
  package "Hệ thống, hỏi đáp" {
    usecase "UC01 Đăng nhập,\nđổi mật khẩu" as UC01
    usecase "UC02 Hỏi đáp bằng\nngôn ngữ tự nhiên" as UC02
    usecase "UC03 Xem lịch sử câu hỏi" as UC03
    usecase "UC04 Đánh giá câu trả lời" as UC04
    usecase "UC05 Xuất kết quả CSV" as UC05
    usecase "UC06 Quản lý từ điển\nthuật ngữ" as UC06
  }
  package "Nghiệp vụ CLB" {
    usecase "UC07 Quản lý thành viên" as UC07
    usecase "UC08 Quản lý sự kiện" as UC08
    usecase "UC09 Điểm danh" as UC09
    usecase "UC10 Quản lý ngân sách" as UC10
    usecase "UC11 Đề xuất khoản chi" as UC11
    usecase "UC12 Duyệt khoản chi" as UC12
    usecase "UC13 Quản lý khoản thu" as UC13
    usecase "UC14 Xem tổng quan" as UC14
    usecase "UC15 Xem báo cáo" as UC15
  }
  package "Quản trị" {
    usecase "UC16 Xem nhật ký thay đổi" as UC16
    usecase "UC17 Cấu hình model LLM" as UC17
    usecase "UC18 Quản lý tài khoản" as UC18
    usecase "UC19 Xem nhật ký truy vấn" as UC19
  }
}

UC01 <-- ND
UC02 <-- ND
UC03 <-- ND
UC04 <-- ND
UC05 <-- ND
UC14 <-- ND
UC15 <-- ND

CN --> UC06
CN --> UC07
CN --> UC08
CN --> UC09
CN --> UC12
CN --> UC16

SK --> UC08
SK --> UC09

TQ --> UC10
TQ --> UC11
TQ --> UC13

QT --> UC06
QT --> UC16
QT --> UC17
QT --> UC18
QT --> UC19

UC02 --> LLM

note as N1
  Chủ nhiệm, Thủ quỹ, Ban sự kiện, Quản trị hệ thống
  đều là Người dùng (tổng quát hoá): mọi vai trò
  thực hiện được UC01–UC05, UC14, UC15.
end note
ND .. N1

note bottom of UC12
  Tách nhiệm vụ: Thủ quỹ đề xuất,
  Chủ nhiệm duyệt (BR08)
end note
@enduml
