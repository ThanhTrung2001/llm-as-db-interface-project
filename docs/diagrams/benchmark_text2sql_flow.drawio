  <diagram id="p3" name="2b. Chấm EX (evaluation.py)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="3200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="③ CHẤM EX — Execution Accuracy (evaluation.py)" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Script gốc của BIRD, không sửa (&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;bird/llm/src/evaluation.py&lt;/font&gt;). Chạy 2 lần cho mỗi model: thư mục &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;*_output/&lt;/font&gt; → &lt;b&gt;EX with knowledge&lt;/b&gt;; thư mục &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;*_0_output/&lt;/font&gt; → &lt;b&gt;EX without knowledge&lt;/b&gt;." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 1. Chạy lệnh — main (argparse)&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;evaluation.py&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;python src/evaluation.py --predicted_sql_path ./exp_result/openai_output/ --ground_truth_path ./data/ --data_mode dev --db_root_path ../data/dev_databases/ --diff_json_path ../data/dev.json --num_cpus 8 --meta_time_out 30.0&lt;/font&gt;&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--predicted_sql_path&lt;/font&gt;: thư mục chứa predict_dev.json (phải có / cuối vì code nối chuỗi)&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--ground_truth_path&lt;/font&gt;: thư mục chứa dev_gold.sql&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--data_mode dev&lt;/font&gt;: ghép tên file &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;predict_dev.json&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;dev_gold.sql&lt;/font&gt;&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--db_root_path&lt;/font&gt;: thư mục 11 CSDL&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--diff_json_path&lt;/font&gt;: dev.json — chỉ để lấy &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;difficulty&lt;/font&gt;&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--num_cpus&lt;/font&gt;: số tiến trình song song · &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--meta_time_out&lt;/font&gt;: giây tối đa/câu&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--mode_predict gpt&lt;/font&gt; / &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--mode_gt gt&lt;/font&gt;: cách đọc file&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Khởi tạo biến toàn cục &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;exec_result = []&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;args&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="800" height="353" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 2a. package_sqls(predicted_sql_path, db_root_path, mode=&#39;gpt&#39;, data_mode=&#39;dev&#39;)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;predict_dev.json&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Với mỗi (idx, sql_str): &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;sql, db_name = sql_str.split(&#39;\t----- bird -----\t&#39;)&lt;/font&gt;; nếu giá trị không phải str → (&quot; &quot;, &quot;financial&quot;); &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;db_path = db_root_path + db_name + &#39;/&#39; + db_name + &#39;.sqlite&#39;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;pred_queries&lt;/font&gt; (1.534 SQL), &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;db_paths&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="513" width="380" height="287" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 2b. package_sqls(ground_truth_path, db_root_path, mode=&#39;gt&#39;, data_mode=&#39;dev&#39;)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;dev_gold.sql&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Đọc từng dòng: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;sql, db_name = line.strip().split(&#39;\t&#39;)&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;gt_queries&lt;/font&gt; (1.534 SQL), &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;db_paths_gt&lt;/font&gt; (không dùng)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="513" width="380" height="238" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 3. query_pairs = list(zip(pred_queries, gt_queries))&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Ghép cặp theo chỉ số i&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;[(pred_0, gold_0), …, (pred_1533, gold_1533)]&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="850" width="400" height="172" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 4–5. run_sqls_parallel(sqls, db_places, num_cpus, meta_time_out)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;query_pairs&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;db_paths&lt;/font&gt; (của pred), &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;num_cpus&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;meta_time_out&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;pool = mp.Pool(num_cpus)&lt;/font&gt;; với mỗi cặp i: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;pool.apply_async(execute_model, args=(pred, gold, db_paths[i], i, meta_time_out), callback=result_callback)&lt;/font&gt;; &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;pool.close(); pool.join()&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Không trả về; &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;result_callback&lt;/font&gt; append từng kết quả vào &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;exec_result&lt;/font&gt; (thứ tự lộn xộn)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1072" width="800" height="238" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="query_pairs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 4. execute_model(predicted_sql, ground_truth, db_place, idx, meta_time_out)&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;chạy trong 1 tiến trình con&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;cặp SQL thứ idx + đường dẫn CSDL&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;res = func_timeout(meta_time_out, execute_sql, args=(predicted_sql, ground_truth, db_place))&lt;/font&gt;&lt;br&gt;Hết giờ (&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;FunctionTimedOut&lt;/font&gt;) → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;res = 0&lt;/font&gt;; SQL lỗi cú pháp / sai tên cột (Exception) → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;res = 0&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;{&#39;sql_idx&#39;: idx, &#39;res&#39;: 0 | 1}&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="1370" width="740" height="238" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 5. execute_sql(predicted_sql, ground_truth, db_path)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;cặp SQL, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;db_path&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;conn = sqlite3.connect(db_path)&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;cursor.execute(predicted_sql); predicted_res = cursor.fetchall()&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;cursor.execute(ground_truth); ground_truth_res = cursor.fetchall()&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;res = 1 if set(predicted_res) == set(ground_truth_res) else 0&lt;/font&gt;&lt;br&gt;→ so &lt;b&gt;tập&lt;/b&gt; các dòng: không xét thứ tự dòng, dòng trùng, tên cột; nhưng thứ tự/số cột trong mỗi dòng phải khớp&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;res&lt;/font&gt; ∈ {0, 1}" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="1648" width="680" height="304" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="mỗi cặp i (song song)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c13" target="c14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="callback → exec_result.append(result)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;fontColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c11">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="860" y="1912" />
              <mxPoint x="860" y="1270" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c18" value="MULTIPROCESSING POOL — 1.534 tác vụ" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=none;dashed=1;strokeColor=#888888;fontSize=13;fontStyle=1;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="50" y="1330" width="780" height="642" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 6. sort_results(exec_result)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;exec_result&lt;/font&gt; (thứ tự hoàn thành)&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;sorted(list, key=lambda x: x[&#39;sql_idx&#39;])&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;list 1.534 kết quả theo đúng thứ tự dev.json" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="2012" width="800" height="221" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="pool.join()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 7. compute_acc_by_diff(exec_results, diff_json_path)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;exec_result&lt;/font&gt; đã sắp xếp, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;dev.json&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Chia kết quả theo &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;content[&#39;difficulty&#39;]&lt;/font&gt; (simple / moderate / challenging).&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;acc_nhóm = Σ res / số câu của nhóm;  all_acc = Σ res / 1534&lt;/font&gt;; nhân 100&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;simple_acc, moderate_acc, challenging_acc, all_acc&lt;/font&gt; (%), &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;count_lists = [925, 464, 145, 1534]&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="2273" width="800" height="238" as="geometry" />
        </mxCell>
        <mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c19" target="c21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c23" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 7. print_data(score_lists, count_lists)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;4 điểm + 4 số lượng&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;In bảng ra console&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;simple&amp;nbsp;&amp;nbsp;moderate&amp;nbsp;&amp;nbsp;challenging&amp;nbsp;&amp;nbsp;total&lt;br&gt;count&amp;nbsp;&amp;nbsp;&amp;nbsp;925&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;464&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;145&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;1534&lt;br&gt;accuracy&amp;nbsp;…&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="2551" width="800" height="271" as="geometry" />
        </mxCell>
        <mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c21" target="c23">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c25" value="&lt;b&gt;CÔNG THỨC EX&lt;/b&gt;&lt;hr&gt;EX = (1/N) · Σ&lt;sub&gt;n&lt;/sub&gt; 𝟙(V̂&lt;sub&gt;n&lt;/sub&gt; = V&lt;sub&gt;n&lt;/sub&gt;) × 100&lt;br&gt;V̂ = tập kết quả của SQL dự đoán, V = tập kết quả của gold SQL, N = 1.534&lt;br&gt;&lt;hr&gt;&lt;b&gt;Các trường hợp res = 0:&lt;/b&gt;&lt;br&gt;• kết quả khác gold&lt;br&gt;• SQL lỗi (no such column / function, syntax…)&lt;br&gt;• chạy quá &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;meta_time_out&lt;/font&gt; giây&lt;br&gt;• SQL rỗng &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;&quot;SELECT&quot;&lt;/font&gt; (do lỗi gọi model)&lt;br&gt;&lt;hr&gt;&lt;b&gt;Ví dụ câu 1379:&lt;/b&gt; pred &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;COUNT(*) … STRFTIME(&#39;%Y&#39;, event_date) = &#39;2020&#39;&lt;/font&gt; và gold &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;COUNT(event_id) … SUBSTR(event_date,1,4) = &#39;2020&#39;&lt;/font&gt; cùng trả [(n,)] → res = 1" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="920" y="110" width="560" height="287" as="geometry" />
        </mxCell>
        <mxCell id="c26" value="&lt;b&gt;CHẠY 2 TRƯỜNG HỢP&lt;/b&gt;&lt;hr&gt;&lt;b&gt;EX with knowledge:&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--predicted_sql_path ./exp_result/openai_output/&lt;/font&gt;&lt;br&gt;&lt;b&gt;EX without knowledge:&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--predicted_sql_path ./exp_result/openai_0_output/&lt;/font&gt;&lt;br&gt;&lt;hr&gt;Các model khác: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;ollama_deepseekcoder_output/&lt;/font&gt; + &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;ollama_deepseekcoder_0_output/&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;ollama_gwen25_output/&lt;/font&gt; + &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;_0_output/&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;ollama_gemma3_output/&lt;/font&gt; + &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;_0_output/&lt;/font&gt;&lt;br&gt;Gold, CSDL, dev.json giữ nguyên ở mọi lượt — chỉ đổi thư mục dự đoán." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="920" y="520" width="560" height="221" as="geometry" />
        </mxCell>
        <mxCell id="c27" value="&lt;b&gt;MỞ RỘNG: chấm theo 6 mức SQL&lt;/b&gt; — &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;app/scripts/ex_ves_by_category.py&lt;/font&gt;&lt;hr&gt;Import lại &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;evaluation.package_sqls / execute_model&lt;/font&gt; và &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;evaluation_ves.execute_model / compute_ves&lt;/font&gt;; &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;classify(gold)&lt;/font&gt; để chia câu vào mức 1–6; gọi thẳng &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;execute_model&lt;/font&gt; từng câu (tránh chia 0 của compute_acc_by_diff khi tập con thiếu một độ khó) → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;ex_ves_by_category_&amp;lt;db&amp;gt;.csv / .xlsx&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="920" y="780" width="560" height="139" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p4" name="2c. Chấm VES (evaluation_ves.py)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="3200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="③ CHẤM VES — Valid Efficiency Score (evaluation_ves.py)" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Script gốc của BIRD, không sửa (&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;bird/llm/src/evaluation_ves.py&lt;/font&gt;). Chạy 2 lần cho mỗi model: thư mục &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;*_output/&lt;/font&gt; → &lt;b&gt;VES with knowledge&lt;/b&gt;; thư mục &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;*_0_output/&lt;/font&gt; → &lt;b&gt;VES without knowledge&lt;/b&gt;." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 1. Chạy lệnh — main (argparse)&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;evaluation_ves.py&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;python src/evaluation_ves.py --predicted_sql_path ./exp_result/openai_output/ --ground_truth_path ./data/ --data_mode dev --db_root_path ../data/dev_databases/ --diff_json_path ../data/dev.json --num_cpus 8 --meta_time_out 30.0 --iterate_num 5&lt;/font&gt;&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--predicted_sql_path&lt;/font&gt;: thư mục chứa predict_dev.json (phải có / cuối vì code nối chuỗi)&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--ground_truth_path&lt;/font&gt;: thư mục chứa dev_gold.sql&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--data_mode dev&lt;/font&gt;: ghép tên file &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;predict_dev.json&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;dev_gold.sql&lt;/font&gt;&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--db_root_path&lt;/font&gt;: thư mục 11 CSDL&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--diff_json_path&lt;/font&gt;: dev.json — chỉ để lấy &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;difficulty&lt;/font&gt;&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--num_cpus&lt;/font&gt;: số tiến trình song song · &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--meta_time_out&lt;/font&gt;: giây tối đa/câu&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--mode_predict gpt&lt;/font&gt; / &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--mode_gt gt&lt;/font&gt;: cách đọc file&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--iterate_num 5&lt;/font&gt;: số lần chạy lại mỗi câu để đo thời gian (paper dùng 5; phải ≥ 2)&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Khởi tạo biến toàn cục &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;exec_result = []&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;args&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="800" height="386" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 2a. package_sqls(predicted_sql_path, db_root_path, mode=&#39;gpt&#39;, data_mode=&#39;dev&#39;)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;predict_dev.json&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Với mỗi (idx, sql_str): &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;sql, db_name = sql_str.split(&#39;\t----- bird -----\t&#39;)&lt;/font&gt;; nếu giá trị không phải str → (&quot; &quot;, &quot;financial&quot;); &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;db_path = db_root_path + db_name + &#39;/&#39; + db_name + &#39;.sqlite&#39;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;pred_queries&lt;/font&gt; (1.534 SQL), &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;db_paths&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="546" width="380" height="287" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 2b. package_sqls(ground_truth_path, db_root_path, mode=&#39;gt&#39;, data_mode=&#39;dev&#39;)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;dev_gold.sql&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Đọc từng dòng: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;sql, db_name = line.strip().split(&#39;\t&#39;)&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;gt_queries&lt;/font&gt; (1.534 SQL), &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;db_paths_gt&lt;/font&gt; (không dùng)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="546" width="380" height="238" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 3. query_pairs = list(zip(pred_queries, gt_queries))&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Ghép cặp theo chỉ số i&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;[(pred_0, gold_0), …, (pred_1533, gold_1533)]&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="883" width="400" height="172" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 4–6. run_sqls_parallel(sqls, db_places, num_cpus, iterate_num, meta_time_out)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;query_pairs&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;db_paths&lt;/font&gt; (của pred), &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;num_cpus&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;iterate_num&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;meta_time_out&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;pool = mp.Pool(num_cpus)&lt;/font&gt;; với mỗi cặp i: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;pool.apply_async(execute_model, args=(pred, gold, db_paths[i], i, iterate_num, meta_time_out), callback=result_callback)&lt;/font&gt;; &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;pool.close(); pool.join()&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Không trả về; &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;result_callback&lt;/font&gt; append từng kết quả vào &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;exec_result&lt;/font&gt; (thứ tự lộn xộn)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1105" width="800" height="238" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="query_pairs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 4. execute_model(predicted_sql, ground_truth, db_place, idx, iterate_num, meta_time_out)&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;chạy trong 1 tiến trình con&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;cặp SQL thứ idx + đường dẫn CSDL&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;time_ratio = func_timeout(meta_time_out * iterate_num, iterated_execute_sql, args=(…))&lt;/font&gt;&lt;br&gt;Hết giờ (&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;FunctionTimedOut&lt;/font&gt;) → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;time_ratio = 0&lt;/font&gt;; SQL lỗi (Exception) → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;time_ratio = 0&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;{&#39;sql_idx&#39;: idx, &#39;time_ratio&#39;: số thực ≥ 0}&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="1403" width="740" height="238" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 4–6. iterated_execute_sql(predicted_sql, ground_truth, db_path, iterate_num)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;cặp SQL, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;db_path&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;iterate_num&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;1. &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;sqlite3.connect(db_path)&lt;/font&gt;; chạy pred → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;fetchall()&lt;/font&gt;; chạy gold → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;fetchall()&lt;/font&gt;&lt;br&gt;2. Nếu &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;set(pred_res) != set(gold_res)&lt;/font&gt; → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;time_ratio = 0&lt;/font&gt; (câu sai, không đo thời gian)&lt;br&gt;3. Nếu đúng: lặp &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;iterate_num&lt;/font&gt; lần: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;t_pred = execute_sql(pred)&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;t_gold = execute_sql(gold)&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;diff_list.append(t_gold / t_pred)&lt;/font&gt;&lt;br&gt;4. &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;processed = clean_abnormal(diff_list)&lt;/font&gt;; &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;time_ratio = mean(processed)&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;time_ratio&lt;/font&gt; (R &gt; 1: pred nhanh hơn gold; R &lt; 1: chậm hơn)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="1681" width="680" height="287" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 5. execute_sql(sql, db_path)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;một câu SQL&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;start = time.time(); cursor.execute(sql); exec_time = time.time() - start&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;số giây" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="2008" width="300" height="238" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 6. clean_abnormal(input)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;diff_list&lt;/font&gt; (iterate_num tỉ lệ)&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;mean, std; giữ x nếu &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;mean − 3·std &amp;lt; x &amp;lt; mean + 3·std&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;list đã lọc ngoại lai" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="2008" width="320" height="238" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="mỗi cặp i (song song)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c13" target="c14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="×2·iterate_num" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c15">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c16">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="callback → exec_result.append(result)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;fontColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c11">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="860" y="2206" />
              <mxPoint x="860" y="1303" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c22" value="MULTIPROCESSING POOL — 1.534 tác vụ" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=none;dashed=1;strokeColor=#888888;fontSize=13;fontStyle=1;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="50" y="1363" width="780" height="903" as="geometry" />
        </mxCell>
        <mxCell id="c23" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 7. sort_results(exec_result)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;exec_result&lt;/font&gt; (thứ tự hoàn thành)&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;sorted(list, key=lambda x: x[&#39;sql_idx&#39;])&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;list 1.534 kết quả theo đúng thứ tự dev.json" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="2306" width="800" height="221" as="geometry" />
        </mxCell>
        <mxCell id="c24" value="pool.join()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c23">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c25" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 8. compute_ves_by_diff(exec_results, diff_json_path)  →  compute_ves(results)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;exec_result&lt;/font&gt; đã sắp xếp, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;dev.json&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Chia kết quả theo &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;content[&#39;difficulty&#39;]&lt;/font&gt; của dev.json (cùng chỉ số i). Với mỗi nhóm gọi &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;compute_ves&lt;/font&gt;:&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;total_ratio = Σ sqrt(time_ratio) × 100;  ves = total_ratio / số câu của nhóm&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;simple_ves, moderate_ves, challenging_ves, all_ves, count_lists&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="2567" width="800" height="238" as="geometry" />
        </mxCell>
        <mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c23" target="c25">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c27" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 8. print_data(score_lists, count_lists)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;4 điểm + 4 số lượng&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;In bảng ra console&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;simple&amp;nbsp;&amp;nbsp;moderate&amp;nbsp;&amp;nbsp;challenging&amp;nbsp;&amp;nbsp;total&lt;br&gt;count&amp;nbsp;&amp;nbsp;&amp;nbsp;925&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;464&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;145&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;1534&lt;br&gt;ves&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;…&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="2845" width="800" height="271" as="geometry" />
        </mxCell>
        <mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c25" target="c27">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c29" value="&lt;b&gt;CÔNG THỨC VES&lt;/b&gt;&lt;hr&gt;VES = (1/N) · Σ&lt;sub&gt;n&lt;/sub&gt; 𝟙(V̂&lt;sub&gt;n&lt;/sub&gt; = V&lt;sub&gt;n&lt;/sub&gt;) · √R(Ŷ&lt;sub&gt;n&lt;/sub&gt;, Y&lt;sub&gt;n&lt;/sub&gt;) × 100&lt;br&gt;R = trung bình (t_gold / t_pred) sau khi lọc ngoại lai&lt;br&gt;&lt;hr&gt;&lt;b&gt;Đóng góp của 1 câu:&lt;/b&gt;&lt;br&gt;• sai / lỗi / timeout → 0&lt;br&gt;• đúng, nhanh bằng gold (R=1) → 100&lt;br&gt;• đúng, nhanh gấp 4 lần (R=4) → 200&lt;br&gt;• đúng, chậm gấp 4 lần (R=0.25) → 50&lt;br&gt;&lt;hr&gt;Lưu ý: phụ thuộc thời gian chạy thực → dao động nhẹ giữa các lần chấm; VES có thể &gt; EX nếu SQL sinh ra chạy nhanh hơn gold." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="920" y="110" width="560" height="287" as="geometry" />
        </mxCell>
        <mxCell id="c30" value="&lt;b&gt;CHẠY 2 TRƯỜNG HỢP&lt;/b&gt;&lt;hr&gt;&lt;b&gt;VES with knowledge:&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--predicted_sql_path ./exp_result/openai_output/&lt;/font&gt;&lt;br&gt;&lt;b&gt;VES without knowledge:&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--predicted_sql_path ./exp_result/openai_0_output/&lt;/font&gt;&lt;br&gt;&lt;hr&gt;Các model khác: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;ollama_deepseekcoder_output/&lt;/font&gt; + &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;ollama_deepseekcoder_0_output/&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;ollama_gwen25_output/&lt;/font&gt; + &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;_0_output/&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;ollama_gemma3_output/&lt;/font&gt; + &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;_0_output/&lt;/font&gt;&lt;br&gt;Gold, CSDL, dev.json giữ nguyên ở mọi lượt — chỉ đổi thư mục dự đoán." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="920" y="520" width="560" height="221" as="geometry" />
        </mxCell>
        <mxCell id="c31" value="&lt;b&gt;MỞ RỘNG: chấm theo 6 mức SQL&lt;/b&gt; — &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;app/scripts/ex_ves_by_category.py&lt;/font&gt;&lt;hr&gt;Import lại &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;evaluation.package_sqls / execute_model&lt;/font&gt; và &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;evaluation_ves.execute_model / compute_ves&lt;/font&gt;; &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;classify(gold)&lt;/font&gt; để chia câu vào mức 1–6; gọi thẳng &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;execute_model&lt;/font&gt; từng câu (tránh chia 0 của compute_acc_by_diff khi tập con thiếu một độ khó) → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;ex_ves_by_category_&amp;lt;db&amp;gt;.csv / .xlsx&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="920" y="780" width="560" height="139" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p5" name="2d. Ma trận chạy &amp; Bảng kết quả">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="④ MA TRẬN CHẠY &amp; BẢNG KẾT QUẢ CUỐI CÙNG" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Vòng ngoài: for model in MODELS&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;Kaggle notebook / terminal&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;MODELS = [gpt-3.5-turbo, deepseek-coder-v2:16b, qwen2.5-coder:7b, gemma3:12b, (gpt-oss-20b/120b qua Groq…)]&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Với mỗi model chạy 2 cấu hình (with / without knowledge) qua luồng ② → mỗi cấu hình 1 file predict_dev.json&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;8–10 file predict_dev.json" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="520" height="254" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;with knowledge&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;python src/ollama_request2.py --model qwen2.5-coder:7b --data_output_path exp_result/ollama_gwen25_output/predict_dev.json&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="394" width="250" height="122" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;without knowledge&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;python src/ollama_request2.py --model qwen2.5-coder:7b --no_knowledge --data_output_path exp_result/ollama_gwen25_0_output/predict_dev.json&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="310" y="394" width="250" height="139" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2" target="c3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2" target="c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;b&gt;Chấm mỗi thư mục&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;evaluation.py&lt;/font&gt; → EX · &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;evaluation_ves.py --iterate_num 5&lt;/font&gt; → VES&lt;br&gt;(notebook &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;run-evaluation-kaggle.ipynb&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;evaluation-and-ves-local.ipynb&lt;/font&gt;)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="583" width="520" height="89" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="&lt;b&gt;Tổng hợp&lt;/b&gt; → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;exp_result/summary_ex_ves.csv&lt;/font&gt;&lt;br&gt;cột: Model, EX_wo_knowledge, EX_w_knowledge, VES_wo_knowledge, VES_w_knowledge" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;size=0.08;" vertex="1" parent="1">
          <mxGeometry x="40" y="722" width="520" height="89" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="4 số / model" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="&lt;b&gt;BẢNG KẾT QUẢ (dev 1.534 câu)&lt;/b&gt;&lt;hr&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;5&quot; style=&quot;border-collapse:collapse;font-size:12px&quot;&gt;&lt;tr style=&quot;background:#eeeeee&quot;&gt;&lt;th&gt;Model&lt;/th&gt;&lt;th&gt;EX w/o KG&lt;/th&gt;&lt;th&gt;EX w/ KG&lt;/th&gt;&lt;th&gt;VES w/o KG&lt;/th&gt;&lt;th&gt;VES w/ KG&lt;/th&gt;&lt;th&gt;Nguồn&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ChatGPT (paper BIRD, Table 2)&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;37.22 (bản dev sửa 09/2023: 42.24)&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;paper / leaderboard&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;GPT-3.5-Turbo&lt;/b&gt; (tái lập)&lt;/td&gt;&lt;td&gt;31.23&lt;/td&gt;&lt;td&gt;47.78&lt;/td&gt;&lt;td&gt;33.88&lt;/td&gt;&lt;td&gt;53.88&lt;/td&gt;&lt;td&gt;summary_ex_ves.csv&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;DeepSeek-Coder-V2 (Ollama)&lt;/td&gt;&lt;td&gt;…&lt;/td&gt;&lt;td&gt;42.11&lt;/td&gt;&lt;td&gt;…&lt;/td&gt;&lt;td&gt;45.80&lt;/td&gt;&lt;td&gt;gap3 ctrl&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Qwen2.5-Coder (Ollama)&lt;/td&gt;&lt;td&gt;…&lt;/td&gt;&lt;td&gt;53.85&lt;/td&gt;&lt;td&gt;…&lt;/td&gt;&lt;td&gt;59.83&lt;/td&gt;&lt;td&gt;gap3 ctrl&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Gemma3 (Ollama)&lt;/td&gt;&lt;td&gt;…&lt;/td&gt;&lt;td&gt;48.70&lt;/td&gt;&lt;td&gt;…&lt;/td&gt;&lt;td&gt;54.86&lt;/td&gt;&lt;td&gt;gap3 ctrl&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;gpt-oss (Groq) / Gemini…&lt;/td&gt;&lt;td&gt;…&lt;/td&gt;&lt;td&gt;…&lt;/td&gt;&lt;td&gt;…&lt;/td&gt;&lt;td&gt;…&lt;/td&gt;&lt;td&gt;chưa chạy đủ&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;b&gt;…&lt;/b&gt; = điền sau khi chấm thư mục &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;*_0_output/&lt;/font&gt; tương ứng. Số &quot;gap3 ctrl&quot; là lượt w/ KG với evidence gốc, đã sửa prompt (PROJECT_LOG mục 8.1).&lt;hr&gt;&lt;b&gt;Nhận xét mong đợi:&lt;/b&gt; w/ KG &amp;gt; w/o KG rõ rệt (GPT-3.5: +16.55 EX, +20.00 VES) → evidence là yếu tố then chốt; model code mở 7B–16B chạy local đã ngang/vượt GPT-3.5." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="620" y="90" width="1180" height="254" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p6" name="3. Luồng Text-to-SQL (ClubQuery)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="4600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="⑤ LUỒNG TEXT-TO-SQL — ứng dụng ClubQuery (1 câu hỏi → SQL → chạy → trả lời → UI)" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Code: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;app/frontend/app.js&lt;/font&gt; → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;app/backend/main.py&lt;/font&gt; → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;service.py&lt;/font&gt; → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;prompt.py, llm.py, guard.py, answer.py&lt;/font&gt;. CSDL nghiệp vụ: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;student_club.sqlite&lt;/font&gt;; CSDL ứng dụng: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;app/data/app.sqlite&lt;/font&gt; (user, model_config, dev_question, benchmark_run/item, glossary_term, query_log)." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="2000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 1. Người dùng đặt câu hỏi trên UI&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;app/frontend/app.js&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Đăng nhập (token) · gõ câu hỏi HOẶC chọn câu mẫu BIRD dev (student_club, id 1312–1469) · chọn chế độ live/replay · chọn model hoặc lượt benchmark · tick &quot;Dùng evidence&quot; · tick &quot;Áp dụng từ điển nghiệp vụ&quot; · (tuỳ chọn) gõ evidence&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Bấm &lt;b&gt;Hỏi&lt;/b&gt; → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;fetch(&#39;POST /api/ask&#39;, {headers: {Authorization: token}, body: AskIn})&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;AskIn = {question, mode: &quot;live&quot;|&quot;replay&quot;, model_id, run_id, dev_question_id, use_evidence, evidence, use_glossary}&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="820" height="238" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 2. current_user(authorization) → main.ask(body, user, conn)&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;app/backend/main.py (FastAPI)&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Header &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;Authorization&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;body: AskIn&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;conn = db()&lt;/font&gt; (kết nối app.sqlite)&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;current_user&lt;/font&gt;: tra token → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;user = {id, username, role ∈ member|board|admin}&lt;/font&gt; (sai → 401)&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;main.ask&lt;/font&gt;: không có question lẫn dev_question_id → 422; gọi &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;service.ask(conn, user, question, mode, model_id, run_id, dev_question_id, use_evidence, evidence, use_glossary)&lt;/font&gt;; &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;ValueError&lt;/font&gt; → 422&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;dict &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;out&lt;/font&gt; từ service.ask → JSON" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="398" width="820" height="254" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="HTTP POST /api/ask" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 3. service.ask — khởi tạo &amp; đọc câu mẫu&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;app/backend/service.py&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;dev_question_id&lt;/font&gt; (có thể None)&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;started = time.monotonic()&lt;/font&gt;; tạo &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;out = {status, sql, columns, rows, answer, error, is_correct, gold_sql, evidence_used, glossary_used, …}&lt;/font&gt;&lt;br&gt;Nếu có câu dev: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;SELECT * FROM dev_question WHERE id = ?&lt;/font&gt; → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;dev_q&lt;/font&gt; {question, evidence, gold_sql}; &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;question = dev_q[&#39;question&#39;]&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;question&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;dev_q&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="702" width="820" height="271" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="mode ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="1023" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 4a. PHÁT LẠI (replay)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;run_id, dev_question_id&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;SELECT b.predicted_sql, r.model_id FROM benchmark_item b JOIN benchmark_run r … WHERE run_id=? AND question_id=?&lt;/font&gt;&lt;br&gt;Không gọi LLM — lấy đúng SQL đã sinh ở luồng benchmark ② (nạp qua per_db_ex.py → POST /api/benchmark/import)&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;sql&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1153" width="260" height="320" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="replay" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 4b.1 Chọn model&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;model_id&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;SELECT * FROM model_config WHERE id=? AND is_active=1&lt;/font&gt; (không có → ValueError)&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;model = {provider, model_tag, base_url, api_key_env}&lt;/font&gt; VD gpt-3.5-turbo / qwen2.5-coder:7b @ http://localhost:11434/v1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="1153" width="520" height="254" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="live" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 4b.2 Ghép evidence&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;match_glossary + normalize_pseudo_sql&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;dev_q.evidence&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;use_evidence&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;evidence&lt;/font&gt; tự nhập, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;use_glossary&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;question&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;parts = []&lt;/font&gt;&lt;br&gt;• có câu dev &amp;amp; use_evidence → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;parts.append(dev_q[&#39;evidence&#39;])&lt;/font&gt;&lt;br&gt;• else có evidence tự nhập → thêm vào&lt;br&gt;• use_glossary → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;match_glossary(conn, question)&lt;/font&gt;: lấy thuật ngữ đang bật có xuất hiện trong câu hỏi (lowercase) → thêm &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;&quot;&amp;lt;term&amp;gt; refers to &amp;lt;definition&amp;gt;&quot;&lt;/font&gt;&lt;br&gt;• &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;knowledge = normalize_pseudo_sql(&#39;; &#39;.join(parts))&lt;/font&gt; hoặc None&lt;br&gt;(tương đương WITH / WITHOUT knowledge của benchmark)&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;knowledge&lt;/font&gt; → lưu &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;out[&#39;evidence_used&#39;]&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;out[&#39;glossary_used&#39;]&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="1447" width="520" height="320" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c12" target="c14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 4b.3 Dựng prompt — prompt.build_prompt(question, knowledge, role)&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;app/backend/prompt.py&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;question&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;knowledge&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;user[&#39;role&#39;]&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;schema_prompt(role)&lt;/font&gt;: CREATE TABLE từ student_club.sqlite, &lt;b&gt;lọc bảng/cột theo vai trò&lt;/b&gt; (member: bỏ budget, expense, income, member.email, member.phone); cache theo role&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;comment_prompt(question, knowledge)&lt;/font&gt;: giống &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;generate_comment_prompt&lt;/font&gt; ở ②&lt;br&gt;Ghép: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;schema + &#39;\n\n&#39; + comment + &#39;\nRespond with the final SQLite query only, inside a ```sql code block. …&#39;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;prompt&lt;/font&gt; (giống prompt của ollama_request.py)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="1807" width="520" height="304" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="knowledge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c16">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 4b.4 Gọi LLM + tách SQL — llm.generate_sql(model, prompt, timeout_s=120)&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;app/backend/llm.py&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;model&lt;/font&gt; (dict), &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;prompt&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;llm.complete(model, prompt, max_tokens=512)&lt;/font&gt;: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;OpenAI(api_key=env[api_key_env], base_url=model.base_url)&lt;/font&gt; → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;chat.completions.create(model=model_tag, messages=[{&#39;role&#39;:&#39;user&#39;,&#39;content&#39;:prompt}], temperature=0, max_tokens=512)&lt;/font&gt; (OpenAI / Groq / Ollama đều tương thích API OpenAI)&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;extract_sql(raw)&lt;/font&gt; — import từ &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;ollama_request.py&lt;/font&gt; (cùng hàm với benchmark)&lt;br&gt;Lỗi → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;LLMError&lt;/font&gt; → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;QueryRejected(&#39;FAILED_GENERATION&#39;)&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;sql&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="2151" width="520" height="320" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c16" target="c18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 5. guard.check_select(sql) — lớp chặn 1 (trên chuỗi)&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;app/backend/guard.py&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;sql&lt;/font&gt; (từ live hoặc replay); &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;out[&#39;sql&#39;] = sql&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;sqlparse.split(sql)&lt;/font&gt;: rỗng → FAILED_GENERATION; &amp;gt; 1 câu → REJECTED_UNSAFE&lt;br&gt;Từ khoá đầu ∈ {INSERT, UPDATE, DELETE, DROP, ALTER, CREATE, PRAGMA, ATTACH…} → REJECTED_UNSAFE&lt;br&gt;Không bắt đầu bằng SELECT / WITH → FAILED_GENERATION&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;sql&lt;/font&gt; đã bỏ ; cuối" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="2531" width="820" height="254" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="sql" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c22" value="sql" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c23" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 6. guard.execute(sql, role, timeout_s=10) — lớp chặn 2 (trong SQLite)&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;app/backend/guard.py&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;sql&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;role&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;connect_readonly()&lt;/font&gt;: mở student_club.sqlite với &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;?mode=ro&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;conn.set_authorizer(_authorizer(role, denied))&lt;/font&gt;: chỉ cho SELECT/READ/FUNCTION/RECURSIVE; đọc bảng/cột bị cấm theo role → từ chối&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;conn.set_progress_handler(…)&lt;/font&gt;: quá 10 s → ngắt&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;cursor.execute(sql); rows = fetchall()&lt;/font&gt;; &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;columns = [d[0] for d in cursor.description]&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;(columns, rows)&lt;/font&gt; → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;out.status = &#39;EXECUTED&#39;&lt;/font&gt;, rows cắt tối đa &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;MAX_ROWS = 1000&lt;/font&gt; (truncated)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="2825" width="820" height="287" as="geometry" />
        </mxCell>
        <mxCell id="c24" value="sql an toàn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c20" target="c23">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c25" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 7. answer.make_answer(question, columns, rows, model)&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;app/backend/answer.py&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;question&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;columns&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;rows&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;model&lt;/font&gt; (None nếu replay)&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Live: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;llm_answer&lt;/font&gt; gửi câu hỏi + tối đa 30 dòng đầu cho LLM, yêu cầu trả lời 1–3 câu tiếng Việt chỉ dựa trên dữ liệu&lt;br&gt;Replay / LLM lỗi: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;template_answer(columns, rows)&lt;/font&gt; → &quot;Kết quả: 12.&quot; / &quot;Có 5 kết quả: …&quot;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;(answer, answer_source ∈ {llm, template})&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="3152" width="820" height="238" as="geometry" />
        </mxCell>
        <mxCell id="c26" value="columns, rows" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c23" target="c25">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c27" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 8. So với đáp án gold (chỉ khi là câu dev — cả live và replay)&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;service.py&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;dev_q[&#39;gold_sql&#39;]&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;rows&lt;/font&gt; của SQL sinh ra&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;gold_cols, gold_rows = guard.execute(gold_sql, &#39;admin&#39;, timeout_s=30)&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;same_result(rows, gold_rows) = set(rows) == set(gold_rows)&lt;/font&gt; — &lt;b&gt;cùng tiêu chí với execute_sql của evaluation.py&lt;/b&gt; (EX)&lt;br&gt;Gold SQL không chạy được → &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;is_correct = None&lt;/font&gt;. (Nếu SQL sinh ra bị chặn/lỗi ở bước 5/6: REJECTED_PERMISSION → None, lỗi khác → 0)&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;out[&#39;gold_sql&#39;]&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;out[&#39;is_correct&#39;] ∈ {1, 0, None}&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="3430" width="820" height="271" as="geometry" />
        </mxCell>
        <mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c25" target="c27">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c29" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 9. Ghi query_log (finally — kể cả khi lỗi/bị chặn)&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;service.py → app.sqlite&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;toàn bộ &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;out&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;user&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;latency_ms = (monotonic() - started)·1000&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;INSERT INTO query_log (user_id, question, mode, model_id, run_id, evidence_used, glossary_used, sql, answer, status, error, latency_ms, row_count, is_correct, …)&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;out[&#39;log_id&#39;]&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;out[&#39;latency_ms&#39;]&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="3741" width="820" height="238" as="geometry" />
        </mxCell>
        <mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c27" target="c29">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c31" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bước 10. Trả JSON → app.js renderResult(out)&lt;/b&gt;&lt;/div&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;app/frontend/app.js&lt;/i&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;▶ INPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;JSON: &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;status, sql, columns, rows, row_count, truncated, answer, answer_source, evidence_used, glossary_used, gold_sql, is_correct, error, latency_ms, log_id&lt;/font&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#9a6700&quot;&gt;⚙ XỬ LÝ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Hiển thị: badge trạng thái · khối SQL · bảng kết quả (≤1000 dòng) · câu trả lời tiếng Việt (nguồn llm/template) · evidence đã đưa vào prompt · thuật ngữ đã áp dụng · gold SQL + nhãn &lt;b&gt;Đúng/Sai&lt;/b&gt; · thời gian xử lý · nút feedback / xuất CSV (board, admin)&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;◀ OUTPUT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Màn hình kết quả cho người dùng" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="4019" width="820" height="271" as="geometry" />
        </mxCell>
        <mxCell id="c32" value="out (JSON)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c29" target="c31">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c33" value="&lt;b&gt;TRẠNG THÁI LỖI (QueryRejected → out.status)&lt;/b&gt;&lt;hr&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; style=&quot;border-collapse:collapse;font-size:11px&quot;&gt;&lt;tr&gt;&lt;th&gt;status&lt;/th&gt;&lt;th&gt;Phát sinh ở&lt;/th&gt;&lt;th&gt;Khi nào&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;FAILED_GENERATION&lt;/td&gt;&lt;td&gt;bước 4b.4, 5&lt;/td&gt;&lt;td&gt;LLM lỗi / SQL rỗng / không phải SELECT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;REJECTED_UNSAFE&lt;/td&gt;&lt;td&gt;bước 5, 6&lt;/td&gt;&lt;td&gt;nhiều câu, lệnh ghi/xoá/PRAGMA…&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;REJECTED_PERMISSION&lt;/td&gt;&lt;td&gt;bước 6&lt;/td&gt;&lt;td&gt;đọc bảng/cột role không được xem&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;TIMEOUT&lt;/td&gt;&lt;td&gt;bước 6&lt;/td&gt;&lt;td&gt;chạy &amp;gt; 10 s&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;EXEC_ERROR&lt;/td&gt;&lt;td&gt;bước 6&lt;/td&gt;&lt;td&gt;sai tên cột, sai cú pháp…&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;EXECUTED&lt;/td&gt;&lt;td&gt;bước 6&lt;/td&gt;&lt;td&gt;thành công&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;Có lỗi → bỏ qua bước 7, 8 (is_correct = 0 với câu dev, trừ REJECTED_PERMISSION = None), vẫn ghi log (bước 9) và trả về UI." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="960" y="110" width="560" height="238" as="geometry" />
        </mxCell>
        <mxCell id="c34" value="lỗi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;fontColor=#555555;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="c20" target="c33">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c35" value="lỗi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;fontColor=#555555;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="c23" target="c33">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c36" value="&lt;b&gt;SO SÁNH VỚI LUỒNG BENCHMARK ②&lt;/b&gt;&lt;hr&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; style=&quot;border-collapse:collapse;font-size:11px&quot;&gt;&lt;tr&gt;&lt;th&gt;&lt;/th&gt;&lt;th&gt;Benchmark ②&lt;/th&gt;&lt;th&gt;Text-to-SQL ⑤&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Đầu vào&lt;/td&gt;&lt;td&gt;1.534 câu dev.json (batch)&lt;/td&gt;&lt;td&gt;1 câu người dùng / câu dev&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Knowledge&lt;/td&gt;&lt;td&gt;evidence hoặc None (--no_knowledge)&lt;/td&gt;&lt;td&gt;evidence + từ điển nghiệp vụ, chuẩn hoá&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Schema&lt;/td&gt;&lt;td&gt;toàn bộ CREATE TABLE&lt;/td&gt;&lt;td&gt;lọc theo vai trò người dùng&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Gọi LLM&lt;/td&gt;&lt;td&gt;call_openai / call_ollama&lt;/td&gt;&lt;td&gt;llm.complete (OpenAI-compatible)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Tách SQL&lt;/td&gt;&lt;td colspan=&quot;2&quot;&gt;extract_sql (dùng chung)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Sau khi có SQL&lt;/td&gt;&lt;td&gt;ghép + ghi predict_dev.json&lt;/td&gt;&lt;td&gt;check_select → execute read-only → answer&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;So đáp án&lt;/td&gt;&lt;td&gt;evaluation.py (EX), evaluation_ves.py (VES) cho cả tập&lt;/td&gt;&lt;td&gt;same_result từng câu (cùng tiêu chí EX)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Đầu ra&lt;/td&gt;&lt;td&gt;điểm EX / VES&lt;/td&gt;&lt;td&gt;bảng kết quả + câu trả lời trên UI + query_log&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="960" y="560" width="560" height="287" as="geometry" />
        </mxCell>
        <mxCell id="c37" value="&lt;b&gt;VÍ DỤ: câu 1379, live, vai trò thủ quỹ (board), tick evidence&lt;/b&gt;&lt;hr&gt;evidence_used = &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;meeting events refers to type = &#39;Meeting&#39;; held in 2020 refers to CAST(STRFTIME(&#39;%Y&#39;, event_date) AS INTEGER) = 2020&lt;/font&gt;&lt;br&gt;sql = &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;SELECT COUNT(*) FROM event WHERE type = &#39;Meeting&#39; AND …&lt;/font&gt;&lt;br&gt;status = EXECUTED, columns = [COUNT(*)], rows = [[n]]&lt;br&gt;answer = &quot;Năm 2020 câu lạc bộ đã tổ chức n buổi họp.&quot;&lt;br&gt;gold chạy ra [[n]] → is_correct = 1 → UI hiện nhãn Đúng" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="960" y="1080" width="560" height="172" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
