# secrets & local env
.env
venv/

# python
__pycache__/
*.pyc
.ipynb_checkpoints/

# raw downloaded archive (already extracted into src/DAMO-ConvAI/bird/data)
src/dev/

# Only keep the BIRD subproject from the DAMO-ConvAI monorepo clone;
# everything else in DAMO-ConvAI is unrelated research code we don't need.
src/DAMO-ConvAI/*
!src/DAMO-ConvAI/bird

src/DAMO-ConvAI/bird/*
!src/DAMO-ConvAI/bird/README.md
!src/DAMO-ConvAI/bird/materials
!src/DAMO-ConvAI/bird/llm
!src/DAMO-ConvAI/bird/data

# not used in this project (we only run the LLM in-context-learning track, not T5 fine-tuning)
src/DAMO-ConvAI/bird/finetuning/

# The entire BIRD dev set (databases + json + gold sql) is a separate download,
# license-restricted (CC BY-SA 4.0) and not meant to be redistributed via this repo.
# Download from https://bird-bench.github.io/ and follow README.md to place it.
src/DAMO-ConvAI/bird/data/dev_databases/
src/DAMO-ConvAI/bird/data/dev.json
src/DAMO-ConvAI/bird/data/dev_tables.json
src/DAMO-ConvAI/bird/data/dev_tied_append.json
src/DAMO-ConvAI/bird/llm/data/dev_gold.sql

# model output for the new providers we run ourselves is regenerated by the scripts;
# keep the original turbo_output(_kg) samples shipped by DAMO-ConvAI as a reference baseline
src/DAMO-ConvAI/bird/llm/exp_result/gemini_output*/
src/DAMO-ConvAI/bird/llm/exp_result/groq_output*/
src/DAMO-ConvAI/bird/llm/run/run_ollama_eval.ps1
