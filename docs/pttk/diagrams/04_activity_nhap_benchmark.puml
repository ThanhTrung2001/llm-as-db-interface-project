@startuml activity_nhap_benchmark
!include _style.iuml
title Biểu đồ hoạt động — UC08 Nhập kết quả benchmark

|Quản trị viên|
start
:Chạy per_db_ex.py trên các file predict_dev.json\n(chấm bằng evaluation.py gốc của BIRD);
:Chọn file benchmark_student_club.json;
:Bấm "Nhập";
|Hệ thống|
if (File có "questions" và "runs"?) then (không)
  :Báo lỗi định dạng;
  stop
endif
:Ghi / cập nhật dev_question (158 câu);
repeat
  if (Model của lượt chạy có trong model_config?) then (không)
    :Huỷ giao dịch, báo lỗi;
    stop
  endif
  :Xoá lượt cũ cùng (model, cấu hình);
  :Ghi benchmark_run và các benchmark_item;
repeat while (Còn lượt chạy?) is (có)
:Commit;
|Quản trị viên|
:Thấy số lượt đã nhập;\nDashboard và danh sách phát lại được cập nhật;
stop
@enduml
