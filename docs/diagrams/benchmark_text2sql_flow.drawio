        <mxCell id="c41" edge="1" parent="1" source="c6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;fontColor=#555555;" target="c35" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c42" edge="1" parent="1" source="c17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;fontColor=#555555;" target="c36" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c43" edge="1" parent="1" source="c21" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;fontColor=#555555;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="c37" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c44" edge="1" parent="1" source="c25" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;fontColor=#555555;" target="c40" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c45" parent="1" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" value="&lt;b&gt;BẢNG THAM SỐ GỌI LLM&lt;/b&gt;&lt;hr&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;3&quot; style=&quot;border-collapse:collapse;font-size:11px&quot;&gt;&lt;tr&gt;&lt;th&gt;Tham số&lt;/th&gt;&lt;th&gt;OpenAI&lt;/th&gt;&lt;th&gt;Ollama&lt;/th&gt;&lt;th&gt;Ý nghĩa&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;temperature&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;tất định&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;max_tokens&lt;/td&gt;&lt;td&gt;256 (CoT 1024)&lt;/td&gt;&lt;td&gt;mặc định&lt;/td&gt;&lt;td&gt;giới hạn độ dài (như paper)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;stop&lt;/td&gt;&lt;td&gt;-- , \n\n , ; , #&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;dừng khi hết câu SQL (như paper)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;retry&lt;/td&gt;&lt;td&gt;5 (lỗi 429)&lt;/td&gt;&lt;td&gt;3 (chờ 3s)&lt;/td&gt;&lt;td&gt;chống lỗi mạng/rate limit&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;timeout&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;120 s&lt;/td&gt;&lt;td&gt;mỗi lần gọi&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="270" width="560" x="900" y="1302" as="geometry" />
