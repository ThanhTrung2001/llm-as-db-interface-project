        </mxCell>
        <mxCell id="pBox" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fillColor=#f5f9ff;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;" value="&lt;div style=&quot;font-size:15px&quot;&gt;&lt;b&gt;②ᵃ DỰNG PROMPT — phần core&lt;/b&gt; &amp;nbsp;&lt;i&gt;(ví dụ câu 1379: &quot;How many meeting events were held in 2020?&quot;, db = student_club)&lt;/i&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="420" width="1380" x="40" y="470" as="geometry" />
        </mxCell>
        <mxCell id="pA" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;A. SCHEMA&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;generate_schema_prompt(db_path)&lt;/font&gt;&lt;hr&gt;Mở .sqlite → đọc &lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;sqlite_master&lt;/font&gt; → lấy câu &lt;b&gt;CREATE TABLE&lt;/b&gt; của mọi bảng (bỏ sqlite_sequence), nối bằng \n\n&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;CREATE TABLE event (&lt;br&gt;&amp;nbsp; event_id TEXT primary key,&lt;br&gt;&amp;nbsp; event_name TEXT, event_date TEXT,&lt;br&gt;&amp;nbsp; type TEXT, notes TEXT, ... )&lt;br&gt;CREATE TABLE major ( ... )&lt;br&gt;... (8 bảng, ~2.200 ký tự)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;⚠ Model KHÔNG thấy dữ liệu mẫu, KHÔNG thấy file mô tả cột&lt;/i&gt;" vertex="1">
          <mxGeometry height="310" width="380" x="60" y="515" as="geometry" />
        </mxCell>
        <mxCell id="pB" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;B. ĐỀ BÀI (comment SQL)&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;generate_comment_prompt(question, knowledge)&lt;/font&gt;&lt;hr&gt;&lt;b&gt;WITH knowledge&lt;/b&gt; — 3 dòng:&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#cf222e&quot;&gt;&lt;b&gt;-- External Knowledge: meeting events refers to type = &#39;Meeting&#39;; held in 2020 refers to YEAR(event_date) = 2020&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;-- Using valid SQLite &lt;b&gt;and understading External Knowledge&lt;/b&gt;, answer the following questions for the tables provided above.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;-- How many meeting events were held in 2020?&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;WITHOUT knowledge&lt;/b&gt; (&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;--no_knowledge&lt;/font&gt;) — 2 dòng:&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;-- Using valid SQLite, answer the following questions for the tables provided above.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;-- How many meeting events were held in 2020?&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#cf222e&quot;&gt;➜ Chỗ khác nhau DUY NHẤT giữa 2 cấu hình&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="310" width="540" x="470" y="515" as="geometry" />
        </mxCell>
        <mxCell id="pC" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;b&gt;C. CÂU DẶN CUỐI&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;generate_combined_prompts_one&lt;/font&gt;&lt;hr&gt;&lt;b&gt;GPT-3.5&lt;/b&gt; (&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;openai_request.py&lt;/font&gt;, giữ đúng paper):&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;Generate the SQL after thinking step by step:&lt;br&gt;SELECT &lt;/font&gt; ← model viết tiếp&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;max_tokens=256, stop=[&#39;--&#39;,&#39;\n\n&#39;,&#39;;&#39;,&#39;#&#39;]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Ollama&lt;/b&gt; (&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;ollama_request.py&lt;/font&gt;):&lt;br&gt;&lt;font face=&quot;Consolas&quot; color=&quot;#1f4e79&quot;&gt;Respond with the final SQLite query only, inside a ```sql code block. Do not add any explanation.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Mồi &quot;SELECT&quot; làm Qwen/DeepSeek trả lời bằng văn xuôi → EX ≈ 0&lt;/i&gt;" vertex="1">
          <mxGeometry height="310" width="350" x="1040" y="515" as="geometry" />
        </mxCell>
        <mxCell id="pPlus1" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#555555;" value="+" vertex="1">
          <mxGeometry height="30" width="30" x="440" y="655" as="geometry" />
        </mxCell>
        <mxCell id="pPlus2" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#555555;" value="+" vertex="1">
          <mxGeometry height="30" width="30" x="1010" y="655" as="geometry" />
